# Public origin (behind Cloudflare CDN). Cloudflare terminates TLS and caches;
# this serves the static Astro build and the immutable media derivatives.
http://syle.studio {
	root * /opt/syle/web
	encode zstd gzip

	# Content-hashed, immutable derivatives — cache hard at the edge.
	@media path /media/*
	header @media Cache-Control "public, max-age=31536000, immutable"

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	file_server
	try_files {path} {path}/ /404.html
}

# Admin origin — bound to loopback; only reachable through the Cloudflare
# Tunnel (cloudflared points here). Same origin as the CRM so the HttpOnly
# session cookie scoped to /api/admin works.
http://127.0.0.1:8081 {
	@api path /api/*
	reverse_proxy @api 127.0.0.1:8080
	# Photo previews for the CRM come from the API's media dir.
	@media path /media/*
	reverse_proxy @media 127.0.0.1:8080

	root * /opt/syle/admin
	file_server
	# SPA fallback for client-side routes (/login, /).
	try_files {path} /index.html
}
