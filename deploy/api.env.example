# Copy to /etc/syle/api.env (chmod 600, owned by root). Never commit the real file.
DATABASE_URL=postgres://syle:CHANGE_ME@localhost:5432/syle_dev
MEDIA_DIR=/opt/syle/media
# WebAuthn relying party (required — the API refuses to start without these).
# RP_ID is the apex domain; passkeys work on admin.* via allow_subdomains.
# RP_ORIGIN is the exact origin the browser loads the CRM from.
RP_ID=syle.studio
RP_ORIGIN=https://admin.syle.studio
