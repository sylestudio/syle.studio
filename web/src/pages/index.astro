---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Mark from "../components/Mark.astro";
import { listGalleries, getGallery } from "../lib/api";

// Each published gallery is a "Proyecto". The list endpoint carries no cover,
// so we pull each detail for its first photo. Resilient: if the API is down
// at build time everything falls back to empty and the static sections still
// render. Title + category come straight from the list payload.
const galleries = await listGalleries();
const projects = await Promise.all(
  galleries.map(async (g) => ({
    slug: g.slug,
    title: g.title,
    category: g.category,
    cover: (await getGallery(g.slug))?.photos?.[0] ?? null,
  })),
);

// Slides del slider "Bleed". Cada entrada:
const slides = [
  { img: "/img/hero.webp", caption: "Simbolo Vivo — Syle Studio",ref: "SYL · 001", url: "/proyectos/catedral" },
  { img: "/img/Slide/Dango.jpg", caption: "Dango — Festival",ref: "SYL · 002", url: "/proyectos/dango" },
  { img: "/img/Slide/Insom.jpg", caption: "Insomnio — Fotografia",ref: "SYL · 003", url: "/proyectos/insomnio" },
  { img: "/img/Slide/Concierto.jpg", caption: "La Obsesion — Fotografia",ref: "SYL · 004", url: "/proyectos/laobsesion" },
  { img: "/img/Slide/Concierto.jpg", caption: "Syle Studio — Estudio Creativo",ref: "SYL · 004", url: "/proyectos/syle" }

];

// Logos del grid "Trabajo conjunto". Cada entrada:
//   logo  → ruta en /public  (ej. "/img/logos/cliente.svg")
//   href  → URL de destino
//   label → texto pequeño en esquina inferior izquierda
//   inv   → true = fondo oscuro (usa variante blanca del logo)
const clients = [
  { logo: "/img/Logos/logo-b.png", href: "https://sylestudio.com", label: "Syle Studio",   inv: false },
  { logo: "/img/Logos/Dango2025.svg", href: "https://festivaldango.com", label: "Festival Dango",   inv: false },
  { logo: "/img/Logos/DGX.png", href: "https://www.instagram.com/dgx.archive/", label: "Cliente tres",  inv: true  },
  { logo: "/img/Logos/in.png", href: "#", label: "Cliente cuatro",inv: false },
  { logo: "/img/Logos/logo-b.png", href: "#", label: "Cliente cinco", inv: false },
  { logo: "/img/Logos/logo-b.png", href: "#", label: "Cliente seis",  inv: true  },
  { logo: "/img/Logos/logo-b.png", href: "#", label: "Cliente siete", inv: false },
];
---

<Base title="Estudio creativo" bare>
  <!-- HERO · light -->
  <header class="hero">
    <div class="hero-in">
      <div class="hero-mark" aria-hidden="true"><Mark /></div>
      <div class="lbl muted" data-reveal>Estudio creativo — Estado de México · 2025</div>
      <h1 class="disp hero-h" data-reveal>
        Maria Jose<br />Eres el amor de mi vida
      </h1>
      <div class="hero-foot">
        <p class="hero-lede" data-reveal>
          Estudio Creativo nacido en México, todos tienen una 
          historia que contar, nuestra inspiracion es ayudarlos 
          a contarla.
        </p>
      </div>
    </div>
  </header>

  <section class="bleed">
    <figure class="bleed-sl" id="bleed-sl">
      <div class="hero-img sl-track">
        {slides.map((s, i) => (
          <div
            class={`sl-slide${i === 0 ? " is-active" : ""}`}
            data-caption={s.caption}
            data-ref={s.ref}
            data-url={s.url}
          >
            <a href={s.url} class="sl-img-link" tabindex="-1" aria-label={s.caption}>
              <img src={s.img} alt={s.caption} />
            </a>
          </div>
        ))}
        <button class="sl-arrow sl-prev" aria-label="Anterior">←</button>
        <button class="sl-arrow sl-next" aria-label="Siguiente">→</button>
      </div>
      <figcaption class="lbl muted cap">
        <a class="sl-cap-text" href={slides[0].url}>{slides[0].caption}</a>
        <span class="sl-counter">{`01 / ${String(slides.length).padStart(2, "0")}`}</span>
        <span class="sl-ref-text">{slides[0].ref}</span>
      </figcaption>
    </figure>
  </section>

  <!-- PROYECTOS · light -->
  <section id="proyectos" class="section">
    <div class="sec-head">
      <h2 class="disp sec-title" data-reveal>Lorem ipsum</h2>
      <span class="lbl muted">{projects.length
        ? `Selección — ${String(projects.length).padStart(2, "0")}`
        : "Archivo"}</span>
    </div>

    {projects.length === 0 ? (
      <p class="lbl muted empty">Aún no hay proyectos publicados.</p>
    ) : (
      <div class="grid">
        {projects.map((p) => (
          <a href={`/galleries/${p.slug}`} class="card" data-reveal>
            <div class="card-img">
              {p.cover ? <Photo photo={p.cover} /> : <div class="ph" />}
            </div>
            {p.category && <span class="lbl muted card-cat">{p.category}</span>}
            <h3 class="disp card-title">
              <span class="ln">{p.title}</span>
            </h3>
          </a>
        ))}
      </div>
    )}
  </section>

  <!-- contraste tonal · dark -->
  <section class="section dark">
    <div class="proc">
      <div class="proc-copy">
        <div class="lbl dim" data-reveal>Mas sobre Syle Studio</div>
        <h2 class="disp proc-h" data-reveal>Syle Studio</h2>
        <p class="proc-p" data-reveal>
          Somos un estudio comprometido con los trabajos e
          ideas que desarrollamos, un poco de nuestro trabajo
          se ve reflejado en nuestra historia.
        </p>
      </div>
      <figure class="proc-fig" data-reveal>
        <img src="/img/about-manifiesto-2.webp" alt="" />
      </figure>
    </div>
  </section>

  <!-- firma · archivo de lettering -->
  <section class="section">
    <div class="sec-head wrap-head">
      <h2 class="disp sec-title" data-reveal>Colaboracion con</h2>
      <span class="lbl muted">Desde 2025 - 2026</span>
    </div>
    <p class="arch-note" data-reveal>
      Desarrollos de algunos proyectos con gente independiente y artistas emergentes <span class="faint"></span>
    </p>
    <div class="arch-grid" data-reveal>
      {clients.map((c) => (
        <a href={c.href} class={`arch-cell${c.inv ? " inv" : ""}`} target="_blank" rel="noopener noreferrer">
          <img src={c.logo} alt="" class="arch-logo" />
          <span class="arch-label lbl">{c.label}</span>
        </a>
      ))}
      <div class="arch-cell next"><span class="lbl faint">Próximo</span></div>
    </div>
  </section>

  <!-- cierre · dark bookend -->
  <section id="contacto" class="section dark close">
    <div class="close-in">
      <div class="close-main">
        <div class="lbl dim" data-reveal>El estudio</div>
        <h2 class="disp close-h" data-reveal>Lorem ipsum amet</h2>
        <a href="mailto:contacto@sylestudio.com" class="cta" data-reveal>
          Iniciar proyecto
          <span class="cta-i" aria-hidden="true">↗</span>
        </a>
      </div>
      <dl class="spec" data-reveal>
        <div><dt class="lbl dim">Trabajos</dt><dd>Dirección · Prendas · Fotografia · Diseño</dd></div>
        <div><dt class="lbl dim">Sede</dt><dd>Estado de Mexico / CDMX</dd></div>
        <div><dt class="lbl dim">Desde</dt><dd>2025</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .muted { color: rgba(22, 20, 15, 0.42); }
  .dim { color: rgba(244, 241, 234, 0.4); }
  .faint { color: rgba(22, 20, 15, 0.32); }
  .ox { color: var(--ox); }

  /* HERO */
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 8rem 1.5rem 2.5rem;
  }
  .hero-in {
    position: relative;
    max-width: 1700px;
    margin: 0 auto;
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  /* Oversized line-art backdrop behind the headline (no fill, traced by the
     script below). Never in flow + behind text (z-index:-1) + pointer-events:
     none, so it can't push or block. Horizontal anchor is fluid: centred on
     small screens, then drifting right as the viewport widens (clamped so the
     right star never bleeds off). */
  .hero-mark {
    position: absolute;
    top: 50%;
    left: clamp(50%, calc(50% + (100vw - 768px) * 0.18), 64%);
    transform: translate(-50%, -50%);
    width: min(95vw, 92vh);
    color: var(--ink);
    z-index: -1;
    pointer-events: none;
  }
  /* line-art: no fill, thin stroke. overflow:visible so the rounded stroke
     caps at the star tips aren't clipped by the svg viewport edge. With no JS /
     reduced motion this stays a solid drawn outline; the script below turns it
     into an endless draw with randomised accel/decel. */
  .hero-mark :global(svg) { overflow: visible; }
  .hero-mark :global(path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 10;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .hero-h {
    font-size: clamp(3.25rem, 15vw, 12rem);
    line-height: 0.86;
    margin-top: auto;
  }
  .hero-foot {
    margin-top: 2.5rem;
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    padding-top: 1.5rem;
    display: flex;
    justify-content: flex-end;
  }
  .hero-lede {
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(22, 20, 15, 0.65);
  }

  .bleed { padding: 0 0 7rem; }
  .bleed figure { overflow: hidden; }
  .cap { padding: 0 1.5rem; }
  .hero-img { height: 62vh; position: relative; overflow: hidden; }
  .sl-img-link { display: block; width: 100%; height: 100%; }
  .hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cap {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
  }
  .sl-ref-text { justify-self: end; }

  /* slider */
  .sl-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s var(--e);
    pointer-events: none;
  }
  .sl-slide.is-active { opacity: 1; pointer-events: auto; }
  .sl-arrow {
    position: absolute;
    bottom: 1.25rem;
    background: rgba(244, 241, 234, 0.88);
    border: none;
    cursor: pointer;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    color: rgba(22, 20, 15, 0.8);
    opacity: 0;
    transition: opacity 0.35s, transform 0.35s var(--e);
    z-index: 2;
  }
  .bleed-sl:hover .sl-arrow { opacity: 1; }
  .sl-arrow:hover { transform: scale(1.08); }
  .sl-prev { right: 4.5rem; }
  .sl-next { right: 1.25rem; }
  .sl-cap-text { color: inherit; text-decoration: none; }
  .sl-cap-text:hover { text-decoration: underline; text-underline-offset: 3px; }
  .sl-counter { font-size: 0.7rem; letter-spacing: 0.06em; }

  /* SECTION shell */
  .section { padding: 7rem 1.5rem; }
  .section > * { max-width: 1700px; margin-left: auto; margin-right: auto; }
  .sec-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    padding-top: 1.5rem;
    margin-bottom: 4rem;
  }
  .dark .sec-head { border-color: rgba(244, 241, 234, 0.15); }
  .sec-title { font-size: clamp(2.5rem, 7vw, 5rem); }
  .empty { padding: 2rem 0 4rem; }

  /* asymmetric project grid */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6rem 2.5rem;
  }
  .card-img { overflow: hidden; aspect-ratio: 4 / 3; }
  .card-img :global(picture),
  .card-img :global(img),
  .card-img .ph { width: 100%; height: 100%; }
  .card-img :global(img) { object-fit: cover; transition: transform 1.1s var(--e); }
  .card:hover .card-img :global(img) { transform: scale(1.04); }
  .ph { background: rgba(22, 20, 15, 0.06); }
  .card-title {
    margin-top: 1.25rem;
    font-size: clamp(1.75rem, 4vw, 3rem);
  }
  .card-cat { display: block; margin-top: 1.25rem; }
  .card-cat + .card-title { margin-top: 0.4rem; }

  /* dark contrast moment */
  .proc { display: grid; gap: 3rem; }
  .proc-h { font-size: clamp(2.5rem, 7vw, 5.5rem); }
  .proc-p {
    margin-top: 2rem;
    max-width: 24rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(244, 241, 234, 0.55);
  }
  .proc-fig { overflow: hidden; }
  .proc-fig img { height: 55vh; object-fit: cover; }

  /* lettering archive */
  .wrap-head { margin-bottom: 1.5rem; }
  .arch-note {
    max-width: 28rem;
    color: rgba(22, 20, 15, 0.5);
    margin-bottom: 4rem;
  }
  .arch-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: rgba(22, 20, 15, 0.15);
  }
  .arch-cell {
    aspect-ratio: 1;
    background: var(--paper);
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    text-decoration: none;
    overflow: hidden;
  }
  .arch-cell.inv { background: var(--dark); }
  .arch-logo {
    width: 65%;
    height: auto;
    opacity: 0.9;
    display: block;
    transition: transform 0.6s var(--e), opacity 0.6s var(--e);
  }
  a.arch-cell:hover .arch-logo {
    transform: scale(1.08);
    opacity: 0.5;
  }
  .arch-label {
    position: absolute;
    bottom: 1.25rem;
    left: 1.5rem;
    color: rgba(22, 20, 15, 0.4);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }
  .arch-cell.inv .arch-label { color: rgba(244, 241, 234, 0.35); }

  /* closing */
  .close { min-height: 100dvh; display: flex; align-items: center; }
  .close-in { display: grid; gap: 4rem; width: 100%; }
  .close-h {
    font-size: clamp(3rem, 12vw, 10rem);
    margin: 2rem 0 3rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--ox);
    color: #fff;
    border-radius: 999px;
    padding: 1rem 1rem 1rem 2rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    transition: transform 0.5s var(--e);
  }
  .cta:active { transform: scale(0.98); }
  .cta-i {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.25);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.5s var(--e);
  }
  .cta:hover .cta-i { transform: translate(3px, -2px); }
  .spec { display: flex; flex-direction: column; gap: 1.5rem; font-size: 0.9rem; }
  .spec > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(244, 241, 234, 0.15);
    padding-top: 0.75rem;
  }
  .spec dd { color: rgba(244, 241, 234, 0.8); }

  @media (min-width: 768px) {
    .hero { padding: 8rem 3rem 2.5rem; }
    .bleed { padding: 0 0 10rem; }
    .cap { padding: 0 3rem; }
    .hero-img { height: 86vh; }
    .section { padding: 11rem 3rem; }

    .grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 6rem 2.5rem;
    }
    .card { grid-column: span 7; }
    .card:nth-child(4n + 2) { grid-column: 9 / span 4; align-self: end; }
    .card:nth-child(4n + 3) { grid-column: 2 / span 5; }
    .card:nth-child(4n) { grid-column: 7 / span 6; align-self: end; }
    .card:nth-child(4n + 2) .card-img { aspect-ratio: 4 / 5; }
    .card:nth-child(4n + 3) .card-img { aspect-ratio: 4 / 5; }
    .card:nth-child(4n) .card-img { aspect-ratio: 16 / 11; }

    .proc { grid-template-columns: 5fr 7fr; align-items: center; }
    .proc-fig img { height: 80vh; }
    .arch-grid { grid-template-columns: repeat(4, 1fr); }

    .close-in {
      grid-template-columns: 7fr 4fr;
      align-items: end;
      gap: 4rem 6rem;
    }
    .spec { font-size: 0.95rem; }
  }
</style>

<script>
  // Bleed slider
  const bleedSl = document.getElementById("bleed-sl");
  if (bleedSl) {
    const slSlides = bleedSl.querySelectorAll<HTMLElement>(".sl-slide");
    const capEl    = bleedSl.querySelector<HTMLAnchorElement>(".sl-cap-text");
    const refEl    = bleedSl.querySelector<HTMLElement>(".sl-ref-text");
    const ctrEl    = bleedSl.querySelector<HTMLElement>(".sl-counter");
    const total    = slSlides.length;
    let cur = 0;

    function goTo(n: number) {
      slSlides[cur].classList.remove("is-active");
      cur = ((n % total) + total) % total;
      slSlides[cur].classList.add("is-active");
      if (capEl) {
        capEl.textContent = slSlides[cur].dataset.caption ?? "";
        capEl.href = slSlides[cur].dataset.url ?? "#";
      }
      if (refEl) refEl.textContent = slSlides[cur].dataset.ref ?? "";
      if (ctrEl) ctrEl.textContent =
        `${String(cur + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
    }

    bleedSl.querySelector(".sl-prev")?.addEventListener("click", () => goTo(cur - 1));
    bleedSl.querySelector(".sl-next")?.addEventListener("click", () => goTo(cur + 1));

    // swipe support on mobile
    let touchX = 0;
    bleedSl.addEventListener("touchstart", (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    bleedSl.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) goTo(cur + (dx < 0 ? 1 : -1));
    });
  }

  // Hero mark line-art: a single lit segment (~60% of the line) travels along
  // each star forever, like headlights on a highway — its leading edge draws new
  // line while its trailing edge erases behind it. No bounce: the dash period
  // equals the path length, so advancing the offset in one direction loops
  // seamlessly. Speed eases toward a fresh random target every ~0.5–1.8s for
  // organic accel/decel; the two stars run on independent seeds. Skipped under
  // reduced motion (CSS leaves a solid outline).
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const paths = document.querySelectorAll<SVGPathElement>(".hero-mark path");

  if (!reduce) {
    paths.forEach((path) => {
      const len = path.getTotalLength();
      const seg = len * 0.6; // lit portion of the line
      path.style.strokeDasharray = `${seg} ${len - seg}`;

      let offset = Math.random() * len; // random start position
      const dir = Math.random() < 0.5 ? 1 : -1; // fixed travel direction
      let speed = len * 0.16; // path units / second
      let target = speed;
      let retargetAt = 0;
      let last = performance.now();

      const tick = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;

        if (now >= retargetAt) {
          target = len * (0.07 + Math.random() * 0.4); // new random cruise speed
          retargetAt = now + 500 + Math.random() * 1300;
        }
        speed += (target - speed) * 0.05; // smooth approach, no jerk

        offset += dir * speed * dt;
        offset = ((offset % len) + len) % len; // wrap one period -> seamless

        path.style.strokeDashoffset = String(offset);
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
</script>
