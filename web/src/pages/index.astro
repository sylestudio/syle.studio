---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Mark from "../components/Mark.astro";
import Wordmark from "../components/Wordmark.astro";
import { listGalleries, getGallery } from "../lib/api";

// Each published gallery is a "Proyecto". The list endpoint carries no cover,
// so we pull each detail for its first photo. Resilient: if the API is down
// at build time everything falls back to empty and the static sections still
// render. Title + category come straight from the list payload.
const galleries = await listGalleries();
const projects = await Promise.all(
  galleries.map(async (g) => ({
    slug: g.slug,
    title: g.title,
    category: g.category,
    cover: (await getGallery(g.slug))?.photos?.[0] ?? null,
  })),
);

const archive = [2013, 2016, 2019, 2022, 2024, 2025, 2026];
---

<Base title="Estudio creativo" bare>
  <!-- HERO · light -->
  <header class="hero">
    <div class="hero-in">
      <div class="hero-mark" aria-hidden="true"><Mark /></div>
      <div class="lbl muted" data-reveal>Estudio creativo — CDMX · MMXXVI</div>
      <h1 class="disp hero-h" data-reveal>
        Lorem ipsum<br />dolor sit amet
      </h1>
      <div class="hero-foot">
        <p class="hero-lede" data-reveal>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
          eiusmod tempor incididunt ut labore et dolore magna aliqua enim.
        </p>
      </div>
    </div>
  </header>

  <section class="bleed">
    <figure data-reveal>
      <div class="hero-img"><img src="/img/hero.webp" alt="" /></div>
      <figcaption class="lbl muted cap">
        <span>Catedral — 35mm</span><span>SYL · 001</span>
      </figcaption>
    </figure>
  </section>

  <!-- PROYECTOS · light -->
  <section id="proyectos" class="section">
    <div class="sec-head">
      <h2 class="disp sec-title" data-reveal>Lorem ipsum</h2>
      <span class="lbl muted">{projects.length
        ? `Selección — ${String(projects.length).padStart(2, "0")}`
        : "Archivo"}</span>
    </div>

    {projects.length === 0 ? (
      <p class="lbl muted empty">Aún no hay proyectos publicados.</p>
    ) : (
      <div class="grid">
        {projects.map((p) => (
          <a href={`/galleries/${p.slug}`} class="card" data-reveal>
            <div class="card-img">
              {p.cover ? <Photo photo={p.cover} /> : <div class="ph" />}
            </div>
            {p.category && <span class="lbl muted card-cat">{p.category}</span>}
            <h3 class="disp card-title">
              <span class="ln">{p.title}</span>
            </h3>
          </a>
        ))}
      </div>
    )}
  </section>

  <!-- contraste tonal · dark -->
  <section class="section dark">
    <div class="proc">
      <div class="proc-copy">
        <div class="lbl dim" data-reveal>Bitácora — sesión de estudio</div>
        <h2 class="disp proc-h" data-reveal>Lorem ipsum dolor sit</h2>
        <p class="proc-p" data-reveal>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
          eiusmod tempor incididunt ut labore et dolore magna.
        </p>
      </div>
      <figure class="proc-fig" data-reveal>
        <img src="/img/about-manifiesto-2.webp" alt="" />
      </figure>
    </div>
  </section>

  <!-- firma · archivo de lettering -->
  <section class="section">
    <div class="sec-head wrap-head">
      <h2 class="disp sec-title" data-reveal>Lorem ipsum dolor</h2>
      <span class="lbl muted">Wordmark — 2013 → 2026</span>
    </div>
    <p class="arch-note" data-reveal>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
      tempor incididunt. <span class="faint">(Lorem ipsum.)</span>
    </p>
    <div class="arch-grid" data-reveal>
      {archive.map((y, i) => (
        <div class={`arch-cell${i === 2 || i === 5 ? " inv" : ""}`}>
          <span class={`lbl ${y === 2026 ? "ox" : "muted"}`}>{y}</span>
          <Wordmark class="arch-mark" />
        </div>
      ))}
      <div class="arch-cell next"><span class="lbl faint">Próximo</span></div>
    </div>
  </section>

  <!-- cierre · dark bookend -->
  <section id="contacto" class="section dark close">
    <div class="close-in">
      <div class="close-main">
        <div class="lbl dim" data-reveal>El estudio</div>
        <h2 class="disp close-h" data-reveal>Lorem ipsum amet</h2>
        <a href="mailto:contacto@sylestudio.com" class="cta" data-reveal>
          Iniciar proyecto
          <span class="cta-i" aria-hidden="true">↗</span>
        </a>
      </div>
      <dl class="spec" data-reveal>
        <div><dt class="lbl dim">Disciplina</dt><dd>Dirección · Prenda · Película</dd></div>
        <div><dt class="lbl dim">Base</dt><dd>Ciudad de México</dd></div>
        <div><dt class="lbl dim">Desde</dt><dd>MMXXVI</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .muted { color: rgba(22, 20, 15, 0.42); }
  .dim { color: rgba(244, 241, 234, 0.4); }
  .faint { color: rgba(22, 20, 15, 0.32); }
  .ox { color: var(--ox); }

  /* HERO */
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 8rem 1.5rem 2.5rem;
  }
  .hero-in {
    position: relative;
    max-width: 1700px;
    margin: 0 auto;
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  /* own layer: anchored in the upper-right negative space, never in flow so it
     can't push the headline. Sized by min(vw,vh) so its height stays in the
     top band and never collides with the bottom-aligned headline. Behind text
     (z-index:-1) as a safety net. */
  .hero-mark {
    position: absolute;
    top: clamp(3rem, 12vh, 9rem);
    right: 0;
    width: min(30vw, 36vh);
    color: var(--ink);
    z-index: -1;
    pointer-events: none;
  }
  .hero-h {
    font-size: clamp(3.25rem, 15vw, 12rem);
    line-height: 0.86;
    margin-top: auto;
  }
  .hero-foot {
    margin-top: 2.5rem;
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    padding-top: 1.5rem;
    display: flex;
    justify-content: flex-end;
  }
  .hero-lede {
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(22, 20, 15, 0.65);
  }

  .bleed { padding: 0 1.5rem 7rem; }
  .bleed figure { max-width: 1700px; margin: 0 auto; overflow: hidden; }
  .hero-img { height: 62vh; }
  .hero-img img { height: 100%; object-fit: cover; }
  .cap {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
  }

  /* SECTION shell */
  .section { padding: 7rem 1.5rem; }
  .section > * { max-width: 1700px; margin-left: auto; margin-right: auto; }
  .sec-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    padding-top: 1.5rem;
    margin-bottom: 4rem;
  }
  .dark .sec-head { border-color: rgba(244, 241, 234, 0.15); }
  .sec-title { font-size: clamp(2.5rem, 7vw, 5rem); }
  .empty { padding: 2rem 0 4rem; }

  /* asymmetric project grid */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6rem 2.5rem;
  }
  .card-img { overflow: hidden; aspect-ratio: 4 / 3; }
  .card-img :global(picture),
  .card-img :global(img),
  .card-img .ph { width: 100%; height: 100%; }
  .card-img :global(img) { object-fit: cover; transition: transform 1.1s var(--e); }
  .card:hover .card-img :global(img) { transform: scale(1.04); }
  .ph { background: rgba(22, 20, 15, 0.06); }
  .card-title {
    margin-top: 1.25rem;
    font-size: clamp(1.75rem, 4vw, 3rem);
  }
  .card-cat { display: block; margin-top: 1.25rem; }
  .card-cat + .card-title { margin-top: 0.4rem; }

  /* dark contrast moment */
  .proc { display: grid; gap: 3rem; }
  .proc-h { font-size: clamp(2.5rem, 7vw, 5.5rem); }
  .proc-p {
    margin-top: 2rem;
    max-width: 24rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(244, 241, 234, 0.55);
  }
  .proc-fig { overflow: hidden; }
  .proc-fig img { height: 55vh; object-fit: cover; }

  /* lettering archive */
  .wrap-head { margin-bottom: 1.5rem; }
  .arch-note {
    max-width: 28rem;
    color: rgba(22, 20, 15, 0.5);
    margin-bottom: 4rem;
  }
  .arch-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: rgba(22, 20, 15, 0.15);
  }
  .arch-cell {
    aspect-ratio: 1;
    background: var(--paper);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .arch-cell.inv { background: var(--dark); }
  .arch-cell.next { align-items: center; justify-content: center; }
  /* arch-mark is a child component's <svg> (out of scope) — size it via
     :global() anchored to the scoped cell; it inherits the cell's currentColor. */
  .arch-cell :global(.arch-mark) {
    width: 70%;
    align-self: center;
    opacity: 0.9;
    color: var(--ink);
  }
  .arch-cell.inv :global(.arch-mark) { color: var(--paper); }

  /* closing */
  .close { min-height: 100dvh; display: flex; align-items: center; }
  .close-in { display: grid; gap: 4rem; width: 100%; }
  .close-h {
    font-size: clamp(3rem, 12vw, 10rem);
    margin: 2rem 0 3rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--ox);
    color: #fff;
    border-radius: 999px;
    padding: 1rem 1rem 1rem 2rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    transition: transform 0.5s var(--e);
  }
  .cta:active { transform: scale(0.98); }
  .cta-i {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.25);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.5s var(--e);
  }
  .cta:hover .cta-i { transform: translate(3px, -2px); }
  .spec { display: flex; flex-direction: column; gap: 1.5rem; font-size: 0.9rem; }
  .spec > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(244, 241, 234, 0.15);
    padding-top: 0.75rem;
  }
  .spec dd { color: rgba(244, 241, 234, 0.8); }

  @media (min-width: 768px) {
    .hero { padding: 8rem 3rem 2.5rem; }
    .bleed { padding: 0 3rem 10rem; }
    .hero-img { height: 86vh; }
    .section { padding: 11rem 3rem; }

    .grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 6rem 2.5rem;
    }
    .card { grid-column: span 7; }
    .card:nth-child(4n + 2) { grid-column: 9 / span 4; align-self: end; }
    .card:nth-child(4n + 3) { grid-column: 2 / span 5; }
    .card:nth-child(4n) { grid-column: 7 / span 6; align-self: end; }
    .card:nth-child(4n + 2) .card-img { aspect-ratio: 4 / 5; }
    .card:nth-child(4n + 3) .card-img { aspect-ratio: 4 / 5; }
    .card:nth-child(4n) .card-img { aspect-ratio: 16 / 11; }

    .proc { grid-template-columns: 5fr 7fr; align-items: center; }
    .proc-fig img { height: 80vh; }
    .arch-grid { grid-template-columns: repeat(4, 1fr); }

    .close-in {
      grid-template-columns: 7fr 4fr;
      align-items: end;
      gap: 4rem 6rem;
    }
    .spec { font-size: 0.95rem; }
  }
</style>
