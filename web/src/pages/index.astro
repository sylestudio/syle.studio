---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import UploadedPicture from "../components/UploadedPicture.astro";
import StaticPicture from "../components/StaticPicture.astro";
import Mark from "../components/Mark.astro";
import Wordmark from "../components/Wordmark.astro";
import {
  listGalleries,
  getGallery,
  listProjects,
  type Photo as GalleryPhoto,
  type UploadedImage,
} from "../lib/api";
import { projectHref } from "../lib/proyectos";

interface HomeProject {
  id: string;
  title: string;
  url: string;
  category: string;
  position: number;
  galleryCover: GalleryPhoto | null;
  uploadedCover: UploadedImage | null;
}

// Published galleries and standalone project links share one ordered grid.
// Galleries still resolve their first photo; standalone projects carry their
// own optimized cover and navigate straight to their configured URL.
const [galleries, standaloneProjects] = await Promise.all([
  listGalleries(),
  listProjects(),
]);
const galleryProjects: HomeProject[] = await Promise.all(
  galleries.map(async (g) => ({
    id: `gallery:${g.id}`,
    title: g.title,
    url: projectHref(g.slug),
    category: g.category,
    position: g.position,
    galleryCover: (await getGallery(g.slug))?.photos?.[0] ?? null,
    uploadedCover: null,
  })),
);
const linkedProjects: HomeProject[] = standaloneProjects.map((project) => ({
  id: `project:${project.id}`,
  title: project.title,
  url: project.url,
  category: project.category,
  position: project.position,
  galleryCover: null,
  uploadedCover: project.cover,
}));
const projects = [...galleryProjects, ...linkedProjects].sort(
  (a, b) => a.position - b.position,
);

// Slides del slider "Bleed". Cada entrada:
const slides = [
  { img: "/img/hero.webp", caption: "Simbolo Vivo — Syle Studio",ref: "SYL · 001", url: "/proyectos/catedral/" },
  { img: "/img/Slide/Dango.jpg", caption: "Dango — Festival",ref: "SYL · 002", url: "/proyectos/dango/" },
  { img: "/img/Slide/Insom.jpg", caption: "Insomnio — Fotografia",ref: "SYL · 003", url: "/proyectos/insomnio/" },
  { img: "/img/Slide/Concierto.jpg", caption: "La Obsesion — Fotografia",ref: "SYL · 004", url: "/proyectos/laobsesion/" },
  { img: "/img/Slide/Portada.jpg", caption: "Syle Studio — Estudio Creativo",ref: "SYL · 005", url: "/proyectos/syle/" }

];

// Logos del grid "Trabajo conjunto". Cada entrada:
//   logo  → ruta en /public  (ej. "/img/logos/cliente.svg")
//   href  → URL de destino
//   label → texto pequeño en esquina inferior izquierda
//   inv   → true = fondo oscuro (usa variante blanca del logo)
const clients = [
  { logo: "/img/Logos/logo-b.png", width: 640, height: 237, href: "https://sylestudio.com", label: "Syle Studio", inv: false },
  { logo: "/img/Logos/Dango2025.svg", width: 7231, height: 1664, href: "https://festivaldango.com", label: "Festival Dango", inv: false },
  { logo: "/img/Logos/DGX.png", width: 512, height: 512, href: "https://www.instagram.com/dgx.archive/", label: "DGX Archive", inv: true },
  { logo: "/img/Logos/achronyme-mono.svg", width: 32, height: 32, href: "https://achrony.me", label: "Achronyme", inv: false },
  { logo: "/img/Logos/ataulfo-mono.svg", width: 1024, height: 1024, href: "https://ataulfo.app", label: "Ataúlfo", inv: false },
  { logo: "/img/Logos/eddndev-wordmark.png", width: 348, height: 58, href: "https://eddndev.com", label: "edd n’ dev", inv: true },
];
---

<Base title="Estudio creativo" bare>
  <main>
  <!-- HERO · light -->
  <header class="hero">
    <div class="hero-in">
      <div class="hero-mark" aria-hidden="true"><Mark /></div>
      <div class="lbl muted">Estudio creativo — Estado de México · 2025</div>
      <h1 class="disp hero-h" aria-label="Syle Studio, nunca dejes de crear.">
        Syle Studio, <br/> Nunca dejes de <span class="rw" id="rewrite" aria-hidden="true">crear.</span>
      </h1>
      <div class="hero-foot">
        <p class="hero-lede">
          Estudio Creativo nacido en México, todos tienen una
          historia que contar, nuestra inspiracion es ayudarlos
          a contarla.
        </p>
      </div>
    </div>
  </header>

  <section class="bleed">
    <figure class="bleed-sl" id="bleed-sl">
      <div class="hero-img sl-track">
        {slides.map((s, i) => (
          <div
            class={`sl-slide${i === 0 ? " is-active" : ""}`}
            data-caption={s.caption}
            data-ref={s.ref}
            data-url={s.url}
          >
            <a href={s.url} class="sl-img-link" tabindex="-1" aria-label={s.caption}>
              <StaticPicture src={s.img} alt={s.caption} fill />
            </a>
          </div>
        ))}
        <button class="sl-arrow sl-prev" aria-label="Anterior">←</button>
        <button class="sl-arrow sl-next" aria-label="Siguiente">→</button>
      </div>
      <figcaption class="lbl muted cap">
        <a class="sl-cap-text" href={slides[0].url}>{slides[0].caption}</a>
        <span class="sl-status">
          <span class="sl-counter">{`01 / ${String(slides.length).padStart(2, "0")}`}</span>
          <button class="sl-toggle" type="button" aria-pressed="false">Pausar</button>
        </span>
        <span class="sl-ref-text">{slides[0].ref}</span>
      </figcaption>
    </figure>
  </section>

  <!-- PROYECTOS · light -->
  <section id="proyectos" class="section">
    <div class="sec-head">
      <h2 class="disp sec-title" data-reveal>Nuestro Trabajo</h2>
      <span class="lbl muted">{projects.length
        ? `Selección — ${String(projects.length).padStart(2, "0")}`
        : "Archivo"}</span>
    </div>

    {projects.length === 0 ? (
      <p class="lbl muted empty">Aún no hay proyectos publicados.</p>
    ) : (
      <div class="grid">
        {projects.map((p) => (
          <a href={p.url} class="card" data-reveal>
            <div class="card-img">
              {p.galleryCover ? (
                <Photo photo={p.galleryCover} />
              ) : p.uploadedCover ? (
                <UploadedPicture image={p.uploadedCover} alt={p.title} />
              ) : (
                <div class="ph" />
              )}
            </div>
            {p.category && <span class="lbl muted card-cat">{p.category}</span>}
            <h3 class="disp card-title">
              <span class="ln">{p.title}</span>
            </h3>
            <!-- El rect no lleva viewBox: lo dimensiona el script en pixeles
                 reales para que el guion mida igual en los cuatro lados. -->
            <span class="card-frame" aria-hidden="true">
              <svg><rect /></svg>
            </span>
          </a>
        ))}
      </div>
    )}
  </section>

  <!-- contraste tonal · dark -->
  <section class="section dark">
    <div class="sec-mark" aria-hidden="true"><Wordmark /></div>
    <div class="proc">
      <div class="proc-copy" data-scroll-text>
        <div class="lbl dim">Mas sobre Syle Studio</div>
        <h2 class="disp proc-h">Syle Studio</h2>
        <p class="proc-p">
          Somos un estudio comprometido con los trabajos e
          ideas que desarrollamos, un poco de nuestro trabajo
          se ve reflejado en nuestra historia.
        </p>
      </div>
      <figure class="proc-fig" data-reveal>
        <StaticPicture
          src="/img/about-manifiesto-2.webp"
          alt=""
          sizes="(min-width: 900px) 55vw, 100vw"
        />
      </figure>
    </div>
  </section>

  <!-- firma · archivo de lettering -->
  <section class="section" data-scroll-text>
    <div class="sec-head wrap-head">
      <h2 class="disp sec-title">Desarrollo Web</h2>
      <span class="lbl muted">Desde 2025 - 2026</span>
    </div>
    <p class="arch-note">
      Desarrollos de algunos proyectos con gente independiente y artistas emergentes <span class="faint"></span>
    </p>
    <!-- el grid de logos queda fuera del troceo por palabras: sus celdas son
         layout (aspect-ratio + posicionado absoluto de la etiqueta) y partirlas
         rompería el responsive. Conserva su reveal normal. -->
    <div class="arch-grid" data-reveal data-no-split>
      {clients.map((c) => (
        <a href={c.href} class={`arch-cell${c.inv ? " inv" : ""}`} target="_blank" rel="noopener noreferrer">
          <img src={c.logo} alt="" class="arch-logo" width={c.width} height={c.height} loading="lazy" decoding="async" />
          <span class="arch-label lbl">{c.label}</span>
        </a>
      ))}
      <div class="arch-cell next"><span class="lbl faint">Próximo</span></div>
    </div>
  </section>

  <!-- cierre · dark bookend -->
  <section id="contacto" class="section dark close" data-scroll-text>
    <div class="sec-mark" aria-hidden="true"><Wordmark /></div>
    <div class="close-in">
      <div class="close-main">
        <div class="lbl dim">Trabaja con nosotros</div>
        <h2 class="disp close-h">Contactanos</h2>
        <!-- el CTA es un control, no prosa: entra de una pieza con el reveal
             normal para no dejar la píldora medio encendida ni desalinear la
             flecha, que vive en un inline-flex centrado. -->
        <!--email_off-->
        <a href="mailto:contacto@sylestudio.com" class="cta" data-reveal data-no-split>
          Iniciar proyecto
          <span class="cta-i" aria-hidden="true">↗</span>
        </a>
        <!--/email_off-->
      </div>
      <dl class="spec">
        <div><dt class="lbl dim">Trabajos</dt><dd>Dirección Creativa · Animación · Fotografía · Diseño · Branding </dd></div>
        <div><dt class="lbl dim">Sede</dt><dd>Estado de Mexico / CDMX</dd></div>
        <div><dt class="lbl dim">Desde</dt><dd>2025</dd></div>
      </dl>
    </div>
  </section>
  </main>
</Base>

<style>
  .muted { color: rgba(22, 20, 15, 0.68); }
  .dim { color: rgba(244, 241, 234, 0.68); }
  .faint { color: rgba(22, 20, 15, 0.62); }
  .ox { color: var(--ox); }

  /* HERO */
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 8rem var(--page-gutter) 2.5rem;
  }
  .hero-in {
    position: relative;
    max-width: var(--layout-max);
    margin: 0 auto;
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  /* Oversized line-art backdrop behind the headline (no fill, traced by the
     script below). Never in flow + behind text (z-index:-1) + pointer-events:
     none, so it can't push or block. Horizontal anchor is fluid: centred on
     small screens, then drifting right as the viewport widens (clamped so the
     right star never bleeds off). */
  .hero-mark {
    position: absolute;
    top: 50%;
    left: clamp(50%, calc(50% + (100vw - 768px) * 0.18), 64%);
    transform: translate(-50%, -50%);
    width: min(95vw, 92vh);
    color: var(--ink);
    z-index: -1;
    pointer-events: none;
  }
  /* line-art: no fill, thin stroke. overflow:visible so the rounded stroke
     caps at the star tips aren't clipped by the svg viewport edge. With no JS /
     reduced motion this stays a solid drawn outline; the script below turns it
     into an endless draw with randomised accel/decel. */
  .hero-mark :global(svg) { overflow: visible; }
  .hero-mark :global(path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 10;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .hero-h {
    font-size: var(--type-hero);
    line-height: 0.86;
    margin-top: auto;
  }
  /* La ultima palabra se reescribe sola (ver script). inline-block con un
     min-width que fija el script al ancho de la variante mas larga: el sobrante
     cae detras del punto, al final del renglon, asi que cambiar de palabra
     nunca recoloca la linea ni mueve el punto. */
  .rw {
    display: inline-block;
    text-align: left;
  }
  /* El cursor solo aparece con el script vivo: sin JS o con reduced motion la
     palabra se queda fija y una barra suelta sobraria. */
  .rw-on::after {
    content: "";
    display: inline-block;
    width: 0.05em;
    height: 0.68em;
    margin-left: 0.08em;
    background: currentColor;
    animation: rw-caret 1.05s steps(1, end) infinite;
  }
  @keyframes rw-caret {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }
  .hero-foot {
    margin-top: 2.5rem;
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    padding-top: 1.5rem;
    display: flex;
    justify-content: flex-end;
  }
  .hero-lede {
    max-width: 34rem;
    font-size: var(--type-body-lg);
    line-height: 1.6;
    color: rgba(22, 20, 15, 0.65);
  }

  .bleed { padding: 0 0 7rem; }
  .bleed figure { overflow: hidden; }
  .cap {
    width: 100%;
    max-width: var(--shell-max);
    margin-left: auto;
    margin-right: auto;
    padding: 0 var(--page-gutter);
  }
  .hero-img { height: 62vh; position: relative; overflow: hidden; }
  .sl-img-link { display: block; width: 100%; height: 100%; }
  .hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cap {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
  }
  .sl-ref-text { justify-self: end; }
  .sl-status { display: inline-flex; align-items: center; gap: 0.75rem; }
  .sl-toggle {
    min-height: 1.5rem;
    border: 0;
    border-left: 1px solid rgba(22, 20, 15, 0.25);
    padding: 0 0 0 0.75rem;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  /* slider */
  .sl-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s var(--e);
    pointer-events: none;
  }
  .sl-slide.is-active { opacity: 1; pointer-events: auto; }
  .sl-arrow {
    position: absolute;
    bottom: 1.25rem;
    background: rgba(244, 241, 234, 0.88);
    border: none;
    cursor: pointer;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--type-body-sm);
    color: rgba(22, 20, 15, 0.8);
    opacity: 0;
    transition: opacity 0.35s, transform 0.35s var(--e);
    z-index: 2;
  }
  .bleed-sl:hover .sl-arrow { opacity: 1; }
  .sl-arrow:focus-visible { opacity: 1; }
  .sl-arrow:hover { transform: scale(1.08); }
  .sl-prev { right: 4.5rem; }
  .sl-next { right: 1.25rem; }
  .sl-cap-text { color: inherit; text-decoration: none; }
  .sl-cap-text:hover { text-decoration: underline; text-underline-offset: 3px; }
  .sl-counter { font-size: var(--type-caption); letter-spacing: 0.06em; }

  @media (prefers-reduced-motion: reduce) {
    .sl-toggle { display: none; }
  }

  /* SECTION shell */
  .section { padding: 7rem var(--page-gutter); }
  #proyectos { padding-inline: 0; }
  .section > * { max-width: var(--layout-max); margin-left: auto; margin-right: auto; }
  /* Las oscuras respiran menos que las claras: aqui el padding es negro puro,
     no aire de papel, y a 7rem x2 pesaba de mas. Solo el eje vertical, para no
     tocar el margen lateral. */
  .section.dark { padding-block: 4.5rem; }

  /* La misma marca de linea trazada del hero, ahora como fondo de las zonas
     negras — pero con el logotipo (Syle_Fuente_Blanco) en vez de las estrellas.
     Sangra por los lados y la seccion recorta lo que sobra: `clip` y no
     `hidden`, para no crear un contenedor de scroll (mismo criterio que el
     html/body de Base). El trazo va a baja opacidad para quedar detras de la
     imagen y del texto sin competir con ellos. */
  .section.dark { position: relative; overflow: clip; }
  .sec-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(190vw, 1200px);
    color: var(--paper);
    opacity: 0.16;
    pointer-events: none;
    z-index: 0;
  }
  /* overflow visible para que los remates redondeados del trazo no se corten
     contra el borde del viewBox */
  .sec-mark :global(svg) { overflow: visible; width: 100%; height: auto; }
  .sec-mark :global(path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 12;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  /* el contenido de la seccion viaja por encima de la marca */
  .section.dark > *:not(.sec-mark) { position: relative; z-index: 1; }
  /* la marca sangra: hay que ganarle en especificidad al `max-width: 1700px`
     que `.section > *` le pondria por ser hija directa */
  .section.dark > .sec-mark { max-width: none; }
  /* En el cierre va mas contenida: la seccion es mas corta y el "Contactanos"
     ya ocupa casi todo el ancho, asi que a tamano completo la linea competia
     con el titular. Se sube el grosor del trazo para compensar la escala menor
     y que la linea no se afine respecto a la otra zona oscura. */
  .close .sec-mark { width: min(120vw, 780px); }
  .close .sec-mark :global(path) { stroke-width: 18; }

  .sec-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    padding-top: 1.5rem;
    margin-bottom: 4rem;
  }
  #proyectos .sec-head,
  #proyectos .empty { width: calc(100% - (2 * var(--page-gutter))); }
  .dark .sec-head { border-color: rgba(244, 241, 234, 0.15); }
  .sec-title { font-size: var(--type-section); }
  .empty { padding: 2rem 0 4rem; }

  /* alternating project grid: two cards, then three */
  #proyectos > .grid {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }
  .card-img { overflow: hidden; aspect-ratio: 4 / 3; }
  .card-img :global(picture),
  .card-img :global(img),
  .card-img .ph { width: 100%; height: 100%; }
  .card-img :global(img) { object-fit: cover; transition: transform 1.1s var(--e); }
  .card:hover .card-img :global(img) { transform: scale(1.04); }
  .ph { background: rgba(22, 20, 15, 0.06); }
  .card-title {
    margin-top: 1.25rem;
    font-size: var(--type-title-sm);
  }
  .card-cat { display: block; margin-top: 1.25rem; }
  .card-cat + .card-title { margin-top: 0.4rem; }

  /* Filo que recorre el borde de la tarjeta entera — portada + texto. Va en
     `mix-blend-mode: difference` para fundirse con la foto y el papel (invierte
     lo que tiene detras). UNA sola linea por tarjeta, muy larga: enciende el
     `FRAME_LIT` del perimetro (ver script) y el hueco restante es el unico
     corte, asi se lee como una linea con cabeza y cola en vez de como un marco
     punteado. Al hacer hover se congela; el ligero zoom de la portada sigue.
     El guion y las medidas del rect las pone el script en pixeles reales: sin
     JS no se pinta nada, que es preferible a un marco mal troceado. */
  .card { position: relative; }
  .card-frame {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    mix-blend-mode: difference;
  }
  .card-frame svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .card-frame rect {
    fill: none;
    stroke: #fff;
    stroke-width: 1;
  }

  /* dark contrast moment */
  .proc { display: grid; gap: 3rem; }
  .proc-h { font-size: var(--type-section); }
  .proc-p {
    margin-top: 2rem;
    max-width: 24rem;
    font-size: var(--type-body-lg);
    line-height: 1.6;
    color: rgba(244, 241, 234, 0.55);
  }
  .proc-fig { overflow: hidden; }
  .proc-fig :global(img) { height: 48vh; object-fit: cover; }

  /* lettering archive */
  .wrap-head { margin-bottom: 1.5rem; }
  .arch-note {
    max-width: 28rem;
    color: rgba(22, 20, 15, 0.68);
    margin-bottom: 4rem;
  }
  .arch-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: rgba(22, 20, 15, 0.15);
  }
  .arch-cell {
    aspect-ratio: 1;
    background: var(--paper);
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    text-decoration: none;
    overflow: hidden;
  }
  .arch-cell.inv { background: var(--dark); }
  .arch-cell.next {
    grid-column: span 2;
    aspect-ratio: 2 / 1;
  }
  .arch-logo {
    width: 65%;
    height: auto;
    opacity: 0.9;
    display: block;
    transition: transform 0.6s var(--e), opacity 0.6s var(--e);
  }
  a.arch-cell:hover .arch-logo {
    transform: scale(1.08);
    opacity: 0.5;
  }
  .arch-label {
    position: absolute;
    bottom: 1.25rem;
    left: 1.5rem;
    color: rgba(22, 20, 15, 0.68);
    font-size: var(--type-caption);
    letter-spacing: 0.04em;
  }
  .arch-cell.inv .arch-label { color: rgba(244, 241, 234, 0.72); }

  /* closing */
  .close { min-height: 70dvh; display: flex; align-items: center; }
  .close-in { display: grid; gap: 4rem; width: 100%; }
  .close-h {
    font-size: var(--type-close);
    margin: 1.5rem 0 2.5rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--ox);
    color: #fff;
    border-radius: 999px;
    padding: 1rem 1rem 1rem 2rem;
    font-size: var(--type-body-sm);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    transition: transform 0.5s var(--e);
  }
  .cta:active { transform: scale(0.98); }
  .cta-i {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.25);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.5s var(--e);
  }
  .cta:hover .cta-i { transform: translate(3px, -2px); }
  .spec { display: flex; flex-direction: column; gap: 1.5rem; font-size: var(--type-body-sm); }
  .spec > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(244, 241, 234, 0.15);
    padding-top: 0.75rem;
  }
  .spec dd { color: rgba(244, 241, 234, 0.8); }

  @media (min-width: 768px) {
    .hero { padding-block: 8rem 2.5rem; }
    .bleed { padding: 0 0 10rem; }
    .hero-img { height: 86vh; }
    .section { padding-block: 11rem; }
    .section.dark { padding-block: 7rem; }
    .sec-mark { width: min(115vw, 2100px); }
    .close .sec-mark { width: min(75vw, 1350px); }

    #proyectos > .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .card { grid-column: span 3; }
    .card:nth-child(5n + 3),
    .card:nth-child(5n + 4),
    .card:nth-child(5n + 5) { grid-column: span 2; }

    .proc { grid-template-columns: 5fr 7fr; align-items: center; }
    .proc-fig :global(img) { height: 68vh; }
    .arch-grid { grid-template-columns: repeat(4, 1fr); }

    .close-in {
      grid-template-columns: 7fr 4fr;
      align-items: end;
      gap: 4rem 6rem;
    }
    .spec { font-size: var(--type-body); }
  }
</style>

<script>
  // Usado tambien mas abajo por las marcas de linea y la reescritura del hero.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Bleed slider
  const bleedSl = document.getElementById("bleed-sl");
  if (bleedSl) {
    const slSlides = bleedSl.querySelectorAll<HTMLElement>(".sl-slide");
    const capEl    = bleedSl.querySelector<HTMLAnchorElement>(".sl-cap-text");
    const refEl    = bleedSl.querySelector<HTMLElement>(".sl-ref-text");
    const ctrEl    = bleedSl.querySelector<HTMLElement>(".sl-counter");
    const toggleEl = bleedSl.querySelector<HTMLButtonElement>(".sl-toggle");
    const total    = slSlides.length;
    let cur = 0;
    let restart = () => {}; // reasignado abajo si el autoplay esta activo

    function goTo(n: number) {
      slSlides[cur].classList.remove("is-active");
      cur = ((n % total) + total) % total;
      slSlides[cur].classList.add("is-active");
      if (capEl) {
        capEl.textContent = slSlides[cur].dataset.caption ?? "";
        capEl.href = slSlides[cur].dataset.url ?? "#";
      }
      if (refEl) refEl.textContent = slSlides[cur].dataset.ref ?? "";
      if (ctrEl) ctrEl.textContent =
        `${String(cur + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
    }

    bleedSl.querySelector(".sl-prev")?.addEventListener("click", () => { goTo(cur - 1); restart(); });
    bleedSl.querySelector(".sl-next")?.addEventListener("click", () => { goTo(cur + 1); restart(); });

    // swipe support on mobile
    let touchX = 0;
    bleedSl.addEventListener("touchstart", (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    bleedSl.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) { goTo(cur + (dx < 0 ? 1 : -1)); restart(); }
    });

    // Autoplay: pausa por interaccion, foco, pestana oculta, salida de viewport
    // o eleccion explicita del usuario. Cada reanudacion empieza un periodo
    // completo para que nunca cambie una imagen inmediatamente tras interactuar.
    if (total > 1 && !reduce) {
      const AUTOPLAY_MS = 5500;
      let timer: ReturnType<typeof setInterval> | undefined;
      let onScreen = true;
      let userPaused = false;
      const pauseReasons = new Set<string>();

      function stop() {
        clearInterval(timer);
        timer = undefined;
      }
      function start() {
        if (timer) return;
        timer = setInterval(() => goTo(cur + 1), AUTOPLAY_MS);
      }
      function sync() {
        if (userPaused || !onScreen || document.hidden || pauseReasons.size > 0) stop();
        else start();
      }
      function setReason(reason: string, paused: boolean) {
        paused ? pauseReasons.add(reason) : pauseReasons.delete(reason);
        sync();
      }
      restart = () => { stop(); sync(); };

      bleedSl.addEventListener("mouseenter", () => setReason("hover", true));
      bleedSl.addEventListener("mouseleave", () => setReason("hover", false));
      bleedSl.addEventListener("focusin", () => setReason("focus", true));
      bleedSl.addEventListener("focusout", (event) => {
        if (!bleedSl.contains(event.relatedTarget as Node | null)) setReason("focus", false);
      });
      bleedSl.addEventListener("touchstart", () => setReason("touch", true), { passive: true });
      bleedSl.addEventListener("touchend", () => setReason("touch", false), { passive: true });
      document.addEventListener("visibilitychange", sync);

      toggleEl?.addEventListener("click", () => {
        userPaused = !userPaused;
        toggleEl.textContent = userPaused ? "Reanudar" : "Pausar";
        toggleEl.setAttribute("aria-pressed", String(userPaused));
        sync();
      });

      new IntersectionObserver(([e]) => {
        onScreen = e.isIntersecting;
        sync();
      }).observe(bleedSl);

      sync();
    } else if (toggleEl) {
      toggleEl.hidden = true;
    }
  }

  // Marco de cada tarjeta de proyecto. El rect se dibuja en PIXELES REALES en
  // vez de un viewBox estirado: con `viewBox` + `preserveAspectRatio="none"` +
  // `non-scaling-stroke` el guion se mide en pantalla mientras el largo del
  // trazo se mide en unidades del viewBox, asi que un unico guion se repetia
  // media docena de veces por tarjeta. Midiendo en pixeles, un solo periodo
  // cubre el perimetro entero: UNA linea, con un unico hueco.
  const FRAME_LIT = 0.8; // fraccion del perimetro encendida (falta el 20%)
  const FRAME_SPEED = 0.2; // ritmo del marco respecto al de las marcas grandes
  const frameLengths = new WeakMap<SVGGeometryElement, number>();
  document.querySelectorAll<HTMLElement>(".card-frame").forEach((host) => {
    const rect = host.querySelector<SVGGeometryElement>("rect");
    if (!rect) return;

    const fit = () => {
      const { width, height } = host.getBoundingClientRect();
      if (!width || !height) return;
      // El trazo se pinta centrado en el borde: se mete media anchura para que
      // no lo recorte la caja de la tarjeta.
      const sw = parseFloat(getComputedStyle(rect).strokeWidth) || 1;
      rect.setAttribute("x", String(sw / 2));
      rect.setAttribute("y", String(sw / 2));
      rect.setAttribute("width", String(Math.max(0, width - sw)));
      rect.setAttribute("height", String(Math.max(0, height - sw)));

      const len = rect.getTotalLength();
      frameLengths.set(rect, len);
      const seg = len * FRAME_LIT;
      rect.style.strokeDasharray = `${seg} ${len - seg}`;
    };

    fit(); // tambien bajo reduced motion: deja el arco fijo, sin animarlo
    new ResizeObserver(fit).observe(host);
  });

  // Line-art marks: las estrellas del hero, el logotipo de fondo de las dos
  // secciones oscuras y el filo que recorre el borde de cada tarjeta del grid de
  // proyectos. Un unico segmento encendido lo recorre para siempre, como faros
  // en una carretera — su borde delantero dibuja linea nueva mientras el trasero
  // borra por detras. Sin rebote: el periodo del guion equivale al largo del
  // trazo, asi que avanzar el offset en un solo sentido cierra el bucle sin
  // costura. La velocidad se interpola hacia un objetivo aleatorio nuevo cada
  // ~0.5-1.8s para acelerar/frenar de forma organica; cada trazo corre con su
  // propia semilla. Se salta bajo reduced motion (el trazo se queda fijo).
  // `reduce` ya viene declarado arriba.
  const marks = document.querySelectorAll<HTMLElement>(
    ".hero-mark, .sec-mark, .card-frame",
  );

  if (!reduce && marks.length) {
    // Una marca fuera de pantalla aparca su cadena de rAF y la retoma donde la
    // dejo al volver a entrar, para no quemar frames con las secciones oscuras
    // mientras no se ven. `paused` hace lo mismo a demanda: el borde de una
    // tarjeta se congela mientras el puntero esta encima.
    const onScreen = new WeakSet<Element>();
    const paused = new WeakSet<Element>();
    const wake = new Map<Element, () => void>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            onScreen.add(e.target);
            wake.get(e.target)?.();
          } else {
            onScreen.delete(e.target);
          }
        });
      },
      { rootMargin: "20% 0px" },
    );

    marks.forEach((host) => {
      // El marco de tarjeta ya trae su guion puesto por `fit` (y re-puesto en
      // cada resize), asi que aqui solo se le mueve el offset. Su largo queda
      // cacheado por ResizeObserver para no forzar una medicion SVG en cada
      // frame. Las marcas de line-art fijan aqui su guion una sola vez.
      const isFrame = host.classList.contains("card-frame");
      const starters = Array.from(
        host.querySelectorAll<SVGGeometryElement>("path, rect"),
      ).map((path) => {
        let len = frameLengths.get(path) ?? path.getTotalLength();
        if (!isFrame) {
          const seg = len * 0.6; // lit portion of the line
          path.style.strokeDasharray = `${seg} ${len - seg}`;
        }

        // El marco va mas lento que las marcas de line-art: es un trazo mucho
        // mas largo y a la misma cadencia relativa pasaba disparado.
        const pace = isFrame ? FRAME_SPEED : 1;
        let offset = Math.random() * len; // random start position
        const dir = Math.random() < 0.5 ? 1 : -1; // fixed travel direction
        let speed = len * 0.16 * pace; // path units / second
        let target = speed;
        let retargetAt = 0;
        let last = 0;
        let running = false;

        const tick = (now: number) => {
          if (!onScreen.has(host) || paused.has(host)) {
            running = false; // aparcado: `wake` lo vuelve a arrancar
            return;
          }
          const dt = Math.min(0.05, (now - last) / 1000);
          last = now;

          if (isFrame) len = frameLengths.get(path) ?? len;

          if (now >= retargetAt) {
            target = len * (0.07 + Math.random() * 0.4) * pace; // new random cruise speed
            retargetAt = now + 500 + Math.random() * 1300;
          }
          speed += (target - speed) * 0.05; // smooth approach, no jerk

          offset += dir * speed * dt;
          offset = ((offset % len) + len) % len; // wrap one period -> seamless

          path.style.strokeDashoffset = String(offset);
          requestAnimationFrame(tick);
        };

        return () => {
          if (running) return;
          running = true;
          last = performance.now(); // sin dt gigante tras la pausa
          requestAnimationFrame(tick);
        };
      });

      wake.set(host, () => starters.forEach((start) => start()));
      io.observe(host);

      // Hover: congela el filo de la tarjeta (el zoom de la portada, que es CSS
      // puro, sigue su curso). Al salir, retoma donde se quedo.
      if (isFrame) {
        const card = host.closest<HTMLElement>(".card");
        card?.addEventListener("mouseenter", () => paused.add(host));
        card?.addEventListener("mouseleave", () => {
          paused.delete(host);
          wake.get(host)?.();
        });
      }
    });
  }

  // Hero: la ultima palabra se reescribe sola, tipo maquina de escribir. El
  // punto final viaja dentro de cada variante para que quede siempre pegado a
  // la palabra en vez de saltar mientras se teclea.
  const rw = document.getElementById("rewrite");
  const RW_WORDS = ["crear.", "creer.", "confiar.", "soñar.", "intentar."];

  if (rw && !reduce) {
    // Se mide la variante mas ancha y se reserva ese hueco: sin esto, pasar de
    // "soñar." a "intentar." puede empujar una linea entera del titular, que a
    // este cuerpo (hasta 12rem) mueve medio hero.
    const reserve = () => {
      const keep = rw.textContent;
      rw.style.minWidth = "0";
      let max = 0;
      RW_WORDS.forEach((w) => {
        rw.textContent = w;
        max = Math.max(max, rw.offsetWidth);
      });
      rw.textContent = keep; // restaurado antes de pintar: no parpadea
      rw.style.minWidth = `${Math.ceil(max)}px`;
    };
    reserve();
    addEventListener("resize", reserve); // el cuerpo es 15vw
    document.fonts?.ready.then(reserve); // la fuente entra tras el 1er pintado

    rw.classList.add("rw-on"); // enciende el cursor

    // Misma cortesia que las marcas de linea: en pausa mientras no se ve.
    let onScreen = true;
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
    }).observe(rw);

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    (async () => {
      let i = 0;
      for (;;) {
        await wait(2200); // tiempo de lectura
        while (!onScreen) await wait(400);

        const from = RW_WORDS[i];
        for (let n = from.length; n > 0; n--) {
          rw.textContent = from.slice(0, n - 1);
          await wait(55); // borrar va mas rapido que teclear
        }

        await wait(260);
        i = (i + 1) % RW_WORDS.length;

        const to = RW_WORDS[i];
        for (let n = 1; n <= to.length; n++) {
          rw.textContent = to.slice(0, n);
          await wait(90);
        }
      }
    })();
  }
</script>
