---
import Base from "../../layouts/Base.astro";
import { listPosts } from "../../lib/api";

const posts = await listPosts();
const fmt = (s: number | null) =>
  s ? new Date(s * 1000).toLocaleDateString("es-MX") : "";
---

<Base
  title="Blog"
  description="Notas, procesos y proyectos de fotografía, dirección creativa y diseño publicados por Syle Studio."
>
  {posts.length === 0 && <p class="empty">Aún no hay entradas.</p>}
  <ul class="post-list">
    {
      posts.map((p) => (
        <li>
          <a href={`/blog/${p.slug}`}>
            <span class="post-title">{p.title}</span>
          </a>
          <div class="post-date">{fmt(p.published_at)}</div>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .empty,
  .post-date { color: rgba(22, 20, 15, 0.62); }
  .post-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .post-title {
    font-size: var(--type-prose-h3);
    font-weight: 600;
  }
  .post-date { font-size: var(--type-body-sm); }
</style>
