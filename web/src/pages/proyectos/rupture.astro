---
import ProyectoBase from "../../layouts/ProyectoBase.astro";
import StaticPicture from "../../components/StaticPicture.astro";

// Misma estructura que syle.astro (hero fijo → header → intro → mampostería
// horizontal → textos → triple → díptico → comunidad → créditos + lightbox).
// NOTA: todas las rutas de imagen son provisionales — apuntan a fotos que ya
// existen en /public/img para que la página se vea; cámbialas por /img/Rupture/…
// cuando estén las definitivas.

// Mampostería de comunidad: fila a sangre de 6 verticales, cada una enlazando
// a su publicación de Instagram.
// NOTA: provisionales las tres cosas — las fotos reusan /img/Obsesion, todos
// los `url` apuntan de momento a la cuenta del estudio (cámbialos por el post
// concreto de cada imagen) y los `alt` son marcadores: descríbelos cuando
// estén las fotos definitivas, que es lo que lee un lector de pantalla al
// anunciar el enlace.
const comunidad = [
  { img: "/img/Obsesion/Play_4.jpg", url: "https://www.instagram.com/sylestudio/", alt: "Comunidad Rupture Collection (1)" },
  { img: "/img/Obsesion/Play_5.jpg", url: "https://www.instagram.com/sylestudio/", alt: "Comunidad Rupture Collection (2)" },
  { img: "/img/Obsesion/Play_6.jpg", url: "https://www.instagram.com/sylestudio/", alt: "Comunidad Rupture Collection (3)" },
  { img: "/img/Obsesion/obs_9.jpg",  url: "https://www.instagram.com/sylestudio/", alt: "Comunidad Rupture Collection (4)" },
  { img: "/img/Obsesion/obs_10.jpg", url: "https://www.instagram.com/sylestudio/", alt: "Comunidad Rupture Collection (5)" },
  { img: "/img/Obsesion/obs_11.jpg", url: "https://www.instagram.com/sylestudio/", alt: "Comunidad Rupture Collection (6)" },
];
---

<ProyectoBase
  title="Rupture Collection"
  description="Rupture Collection es la línea deportiva de Syle Studio: prendas para entrenar, creadas alrededor de la constancia, el movimiento y la perseverancia."
  image="/img/Obsesion/Main.jpg"
>
  <div class="hero-fixed">
    <StaticPicture src="/img/Obsesion/Main.jpg" alt="Rupture Collection" eager fill />
  </div>

  <div class="page-wrap">
    <main>

      <div class="wrap" data-scroll-text>
        <header class="pg-head">
          <span class="lbl muted">SYLE · 006</span>
          <h1 class="disp pg-title">Rupture Collection</h1>
          <p class="pg-meta lbl muted">Colección - 2026</p>
        </header>
      </div>

      <!-- ── Intro grid ──────────────────────────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="intro-grid">
          <div class="intro-left">
            <h2 class="disp intro-h">Constancia</h2>
            <p class="body-s">
              Rupture Collection salió de una temática que hoy está en todos lados:
              el fitness. Nos interesaba menos la estética de gimnasio que lo que
              hay debajo, porque el deporte funciona con las mismas reglas con las
              que trabajamos acá: apareces, repites, y el avance tarda en notarse.
              La perseverancia, la constancia y hacer algo porque de verdad te gusta
              son el centro de Syle Studio, y en el deporte esos sentimientos están
              a la vista sin adornos. Por eso decidimos armar nuestra propia línea
              en lugar de sumarnos a la de alguien más.
            </p>
          </div>
          <div class="intro-right">
            <h2 class="disp intro-h">Rupture Collection</h2>
            <span class="lbl muted">2026</span>
          </div>
        </div>
      </div>

      <!-- ── Mampostería horizontal (avanza con el scroll) ──── -->
      <section class="hscroll">
        <div class="hscroll-pin">
          <div class="masonry-track" id="masonry">
            <!-- ESPACIO con imagen VERTICAL (retrato): una sola foto llena el slot.
                 Cuando tengas verticales, úsalas así:
            <div class="slot">
              <img src="/img/Rupture/Manposteria/TuVertical.jpg" alt="" />
            </div>
            -->
          <div class="slot">
              <StaticPicture src="/img/Obsesion/obs_1.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot">
              <StaticPicture src="/img/Obsesion/obs_2.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot slot--stack">
              <StaticPicture src="/img/Obsesion/obs_3.jpg" alt="" sizes="70vw" fill />
              <StaticPicture src="/img/Obsesion/obs_4.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot">
              <StaticPicture src="/img/Obsesion/obs_5.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot">
              <StaticPicture src="/img/Obsesion/obs_6.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot slot--stack">
              <StaticPicture src="/img/Obsesion/obs_7.jpg" alt="" sizes="70vw" fill />
              <StaticPicture src="/img/Obsesion/obs_8.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot">
              <StaticPicture src="/img/Obsesion/Play.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot slot--stack">
              <StaticPicture src="/img/Obsesion/Play_1.jpg" alt="" sizes="70vw" fill />
              <StaticPicture src="/img/Obsesion/Play_2.jpg" alt="" sizes="70vw" fill />
          </div>
            <!-- ESPACIO con 2 HORIZONTALES apiladas (mismo tamaño que un slot vertical) -->

          </div>
        </div>
      </section>

      <!-- ── Texto de la derecha ───────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="text-r">
          <h2 class="disp sub2-h">Estética de la Colección</h2>
          <p class="body-s">
            El nombre viene de cómo responde el músculo: se rompe en fibras
            pequeñas para volver a armarse más fuerte. Nada crece sin ese
            desgaste previo, y esa lógica es la que ordena la colección. Las
            prendas están pensadas para moverse y para aguantar el uso, con
            cortes que dejan trabajar al cuerpo y acabados que no piden un
            cuidado especial. En la imagen buscamos algo sobrio, sin la carga
            motivacional que suele acompañar a lo deportivo: el esfuerzo se
            muestra, no se anuncia.
          </p>
        </div>
      </div>

      <!-- ── Triple imágenes ────────────────────────────────── -->
      <div class="triple">
        <StaticPicture src="/img/Obsesion/obs_12.jpg" alt="" sizes="(min-width: 700px) 34vw, 100vw" />
        <StaticPicture src="/img/Obsesion/Play_3.jpg" alt="" sizes="(min-width: 700px) 34vw, 100vw" />
        <StaticPicture src="/img/Obsesion/obs_9.jpg" alt="" sizes="(min-width: 700px) 34vw, 100vw" />
      </div>

      <!-- ── Texto centrado ─────────────────────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="text-c">
          <h2 class="disp center-h">El Proceso</h2>
          <p class="body-s">
            Desarrollamos la línea desde cero en vez de adaptar algo que ya
            existiera. Partimos de las prendas que uno se pone de verdad para
            entrenar y fuimos quitando lo que sobraba: costuras que estorban,
            cortes que limitan el movimiento, detalles que solo funcionan en una
            foto. Cada muestra se probó en uso antes de darla por buena, y varias
            piezas cambiaron después de esa prueba. El proceso acabó pareciéndose
            a la idea que sostiene la colección: hacer, revisar, corregir y volver
            a empezar, sin prisa por cerrar.
          </p>
        </div>
      </div>

      <!-- ── Diptych ────────────────────────────────────────── -->
      <div class="diptych">
        <StaticPicture src="/img/Obsesion/Play_4.jpg" alt="" sizes="(min-width: 700px) 50vw, 100vw" />
        <StaticPicture src="/img/Obsesion/Play_5.jpg" alt="" sizes="(min-width: 700px) 50vw, 100vw" />
      </div>

      <!-- ── Comunidad ──────────────────────────────────────── -->
      <div class="wrap" data-scroll-text>
        <p class="com-note body-s">
          Un vistazo a cómo la comunidad entrena y usa la colección.
        </p>
      </div>
      <div class="com-grid">
        {comunidad.map((c) => (
          <a
            href={c.url}
            class="com-cell"
            target="_blank"
            rel="noopener noreferrer"
          >
            <StaticPicture src={c.img} alt={c.alt} sizes="(min-width: 1100px) 17vw, (min-width: 600px) 34vw, 50vw" fill />
            {/* Mismo trazado que /img/instagram.svg (el del footer), pero inline
                para poder darle color desde CSS. aria-hidden porque el nombre
                accesible del enlace ya lo pone el alt de la foto. */}
            <svg class="com-ig" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
              <path d="M22.3,8.4c-0.8,0-1.4,0.6-1.4,1.4c0,0.8,0.6,1.4,1.4,1.4c0.8,0,1.4-0.6,1.4-1.4C23.7,9,23.1,8.4,22.3,8.4z" />
              <path d="M16,10.2c-3.3,0-5.9,2.7-5.9,5.9s2.7,5.9,5.9,5.9s5.9-2.7,5.9-5.9S19.3,10.2,16,10.2z M16,19.9c-2.1,0-3.8-1.7-3.8-3.8c0-2.1,1.7-3.8,3.8-3.8c2.1,0,3.8,1.7,3.8,3.8C19.8,18.2,18.1,19.9,16,19.9z" />
              <path d="M20.8,4h-9.5C7.2,4,4,7.2,4,11.2v9.5c0,4,3.2,7.2,7.2,7.2h9.5c4,0,7.2-3.2,7.2-7.2v-9.5C28,7.2,24.8,4,20.8,4z M25.7,20.8c0,2.7-2.2,5-5,5h-9.5c-2.7,0-5-2.2-5-5v-9.5c0-2.7,2.2-5,5-5h9.5c2.7,0,5,2.2,5,5V20.8z" />
            </svg>
          </a>
        ))}
      </div>

      <!-- ── Créditos ───────────────────────────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="credits">
          <div class="credit-col">
            <span class="lbl muted">Proyecto</span>
            <a href="/proyectos/rupture/" class="ln credit-val disp">Rupture Collection</a>
          </div>
          <div class="credit-col">
            <span class="lbl muted">Diseño</span>
            <a href="https://www.instagram.com/dxniel.py/" class="ln credit-val">Daijin</a>
          </div>
           <div class="credit-col">
            <span class="lbl muted">Estudio</span>
            <a href="/" class="ln credit-val">Syle Studio</a>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- ── Lightbox ── -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Vista ampliada" aria-hidden="true">
    <button class="lightbox-close" type="button" aria-label="Cerrar imagen ampliada">×</button>
    <img alt="" />
  </div>
</ProyectoBase>

<style>
  .muted { color: rgba(22, 20, 15, 0.68); }

  /* ── Shell ── */
  .hero-fixed {
    position: fixed;
    inset: 0;
    z-index: 0;
  }
  .hero-fixed :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .page-wrap {
    position: relative;
    z-index: 1;
    margin-top: 100vh;
    margin-top: 100dvh;
    background: var(--paper);
  }

  .wrap {
    max-width: var(--shell-max);
    margin: 0 auto;
    padding-left: var(--page-gutter);
    padding-right: var(--page-gutter);
  }

  /* ── Header ── */
  .pg-head {
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    padding-top: 10rem;
    padding-bottom: 5rem;
    display: grid;
    gap: 1.25rem;
  }
  .pg-title {
    font-size: var(--type-page);
    line-height: 0.88;
  }

  /* ── Intro grid ── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding-bottom: 5rem;
  }
  .intro-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .intro-right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
  }
  .intro-h {
    font-size: var(--type-heading);
  }

  .body-s {
    font-size: var(--type-body-sm);
    line-height: 1.65;
    color: rgba(22, 20, 15, 0.72);
  }

  /* ── Diptych ── */
  .diptych {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    margin-top: 8rem;
  }
  .diptych :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  /* ── Text right ── */
  .text-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    padding-top: 5rem;
    padding-bottom: 5rem;
    margin-left: auto;
    max-width: 60%;
  }
  .sub2-h {
    font-size: var(--type-heading);
    margin-bottom: 1.5rem;
  }
  .text-r .body-s { max-width: 44ch; }

  /* ── Texto centrado ── */
  .text-c {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 6rem;
    padding-bottom: 6rem;
  }
  .center-h {
    font-size: var(--type-heading);
    margin-bottom: 1.5rem;
  }
  .text-c .body-s { max-width: 52ch; }

  /* ── Triple ── */
  .triple {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 3px;
    align-items: start;
  }
  .triple :global(img) {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 3 / 4;
  }

  /* ── Mampostería horizontal (avanza con el scroll) ──
     Estado base = fallback: tira con scroll horizontal manual. Es lo que queda
     sin JS o con reduced motion, y siempre es usable (se arrastra con el dedo).
     Con JS el script añade .is-pinned y la sección pasa a "pinearse": la tira
     avanza de izquierda a derecha mientras bajas.

     Antes el pin salía de `animation-timeline: view()` y ahí estaba el bug de
     móvil: los navegadores sin scroll-driven animations caían al fallback,
     pero el propio @supports ya les había puesto overflow:hidden en el pin, así
     que la tira ni avanzaba con el scroll ni se dejaba arrastrar — estática.
     Ahora el recorrido lo calcula el script, igual en todos los navegadores. */
  .hscroll {
    position: relative;
  }
  .hscroll-pin {
    overflow-x: auto;
    overflow-y: hidden;
  }
  .masonry-track {
    display: flex;
    gap: 3px;
    width: max-content;
  }
  /* Sistema de ESPACIOS: cada slot mide exactamente lo mismo.
     - .slot          → 1 imagen vertical (retrato) que llena el espacio
     - .slot--stack   → 2 imágenes horizontales apiladas en el mismo espacio */
  .slot {
    flex: 0 0 auto;
    height: 82vh;         /* más alto → verticales más largas */
    width: 46vh;          /* más angosto → formato retrato más estilizado */
  }
  .slot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;     /* la vertical llena el espacio sin deformar */
    display: block;
  }
  /* ESPACIO de 2 horizontales: mismo alto que el slot vertical, pero más ANCHO
     (ancho fijo ~3:2 a media altura) para que la horizontal entre completa
     sin recortarse a lo ancho y sin romper la cuadrícula. */
  .slot--stack {
    width: 62vh;
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 3px;              /* el gap se descuenta del alto automáticamente */
  }

  /* Pin + desplazamiento horizontal. El script mide el recorrido que le sobra
     a la tira y lo publica en --travel; la sección reserva ese alto extra, así
     que 1px de scroll = 1px de avance lateral y el ritmo se ajusta solo al
     número de slots y al tamaño de pantalla (ya no hace falta el 360vh/480vh
     a ojo, que era lo que descuadraba el final de la tira en móvil).

     dvh y no vh: con la barra de URL visible 100vh es MÁS alto que el área
     realmente visible, así que el pin se salía de cuadro justo en móvil. La
     declaración vh queda debajo como fallback para navegadores sin dvh. */
  .hscroll.is-pinned {
    height: calc(100vh + var(--travel, 0px));
    height: calc(100dvh + var(--travel, 0px));
  }
  .hscroll.is-pinned .hscroll-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .hscroll.is-pinned .masonry-track { will-change: transform; }

  /* Accesibilidad: sin pin si el usuario pide reduced motion. El script ya no
     lo activa; esto cubre además que se cambie la preferencia tras la carga. */
  @media (prefers-reduced-motion: reduce) {
    .hscroll.is-pinned { height: auto; }
    .hscroll.is-pinned .hscroll-pin {
      position: static;
      height: auto;
      overflow-x: auto;
    }
    .hscroll.is-pinned .masonry-track { transform: none; }
  }

  /* ── Mampostería de comunidad ──
     Fila a sangre de 6 verticales que enlazan a Instagram. El oscurecido del
     hover NO es un overlay: la celda pinta un fondo oscuro y la foto va encima,
     así que al bajarle la opacidad es ese fondo el que asoma. Un solo elemento
     animado (la <img>), sin pseudo-elemento que mantener en sincronía.
     overflow:hidden para que el zoom se recorte contra el borde de la celda. */
  .com-note {
    max-width: 52ch;
    margin: 0 auto;
    text-align: center;
    padding-top: 6rem;
    padding-bottom: 3rem;
  }
  .com-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 3px;
  }
  .com-cell {
    display: block;
    position: relative;   /* ancla del logo, que va centrado sobre la foto */
    overflow: hidden;
    background: #100e0a;
    /* verticales estilizadas, como los slots de la mampostería horizontal */
    aspect-ratio: 3 / 5;
  }
  .com-cell :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--e), opacity 0.6s var(--e);
  }
  .com-cell:hover :global(img),
  .com-cell:focus-visible :global(img) {
    transform: scale(1.06);
    opacity: 0.55;
  }
  .com-cell:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }
  /* Logo de Instagram: aparece con el mismo gesto que oscurece la foto. Va
     fuera de la <img>, así que no le afecta la bajada de opacidad y se queda
     nítido sobre el fondo oscuro. */
  .com-ig {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(1.75rem, 3vw, 2.5rem);
    height: clamp(1.75rem, 3vw, 2.5rem);
    fill: var(--paper);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
    transition: opacity 0.5s var(--e), transform 0.5s var(--e);
  }
  .com-cell:hover .com-ig,
  .com-cell:focus-visible .com-ig {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  /* 6 columnas sólo caben en pantalla ancha; por debajo se reparten en 3 y 2
     para que la vertical no quede como una tira inservible. */
  @media (max-width: 1100px) {
    .com-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .com-grid { grid-template-columns: repeat(2, 1fr); }
  }
  /* Va aquí y no en el bloque de reduced-motion de arriba: al tener la misma
     especificidad que el :hover, necesita ir después para ganarle. Se queda el
     oscurecido, que no es movimiento. */
  @media (prefers-reduced-motion: reduce) {
    .com-cell :global(img) { transition: opacity 0.6s var(--e); }
    .com-cell:hover :global(img),
    .com-cell:focus-visible :global(img) { transform: none; }
    /* el logo se queda: sólo pierde el escalado, aparece con un fundido */
    .com-ig { transition: opacity 0.5s var(--e); }
    .com-ig,
    .com-cell:hover .com-ig,
    .com-cell:focus-visible .com-ig { transform: translate(-50%, -50%); }
  }

  /* ── Créditos ── */
  .credits {
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    margin-top: 4rem;
    padding-top: 3rem;
    padding-bottom: 6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    justify-content: space-between;
  }
  .credit-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .credit-val {
    width: fit-content;
    font-size: var(--type-body);
  }
  .credit-val.disp {
    font-size: var(--type-title-sm);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .intro-right {
      align-items: flex-start;
      flex-direction: row;
      justify-content: space-between;
    }
    .diptych {
      grid-template-columns: 1fr;
    }
    .text-r {
      max-width: 100%;
      align-items: flex-start;
      text-align: left;
    }
    .triple {
      grid-template-columns: 1fr;
    }

    /* en móvil cada ESPACIO ocupa casi toda la pantalla. dvh para que el slot
       quepa dentro del pin aunque la barra de URL esté visible; el recorrido
       total ya lo calcula el script. */
    .slot {
      height: 82dvh;
      width: 92vw;
    }

    /* Mostrar las fotos completas en móvil, sin recorte */
    .diptych :global(img),
    .triple :global(img),
    .triple :global(img):nth-child(2) {
      width: 100%;
      height: auto;
      aspect-ratio: auto;
      object-fit: contain;
    }
  }

  /* ── Hover discreto + zoom al click ── */
  .diptych :global(img),
  .triple :global(img) {
    cursor: zoom-in;
    transition: filter 0.35s ease, transform 0.35s ease;
  }
  .diptych :global(img):hover,
  .triple :global(img):hover {
    filter: brightness(1.05);
    transform: scale(1.012);
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 4rem);
    background: rgba(16, 14, 10, 0.82);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    cursor: zoom-out;
  }
  .lightbox.open {
    opacity: 1;
    visibility: visible;
  }
  .lightbox img {
    max-width: min(90vw, 1100px);
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    transform: scale(0.96);
    transition: transform 0.3s ease;
  }
  .lightbox.open img { transform: scale(1); }
</style>

<script>
  // ── Mampostería horizontal ──
  // La tira avanza en horizontal mientras la sección está pineada. Va por JS y
  // no por `animation-timeline: view()` para que se comporte igual en todos
  // los navegadores: ese camino no existe en Safari iOS antiguo ni en Firefox,
  // y ahí la sección se quedaba estática.
  //
  // Se publica el recorrido en --travel y la sección reserva ese alto de más,
  // de forma que el tramo pineado dura exactamente lo que mide la tira.
  const hscroll = document.querySelector<HTMLElement>('.hscroll');
  const track = document.getElementById('masonry');
  const noMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hscroll && track && !noMotion) {
    hscroll.classList.add('is-pinned');

    let travel = 0;
    let queued = false;

    const place = () => {
      queued = false;
      // -top va de 0 (la sección toca el borde superior y empieza el pin) a
      // travel (se agota el recorrido y la sección se despega)
      const p = Math.min(Math.max(-hscroll.getBoundingClientRect().top, 0), travel);
      track.style.transform = `translate3d(${-p}px, 0, 0)`;
    };

    const measure = () => {
      const next = Math.max(0, track.scrollWidth - hscroll.clientWidth);
      if (next !== travel) {
        travel = next;
        hscroll.style.setProperty('--travel', `${travel}px`);
      }
      place();
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(place);
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', measure);
    // los slots miden en vh/vw, pero el RO cubre además cambios de layout que
    // no vienen de un resize (fuentes, imágenes que aún no habían cargado)
    if ('ResizeObserver' in window) new ResizeObserver(measure).observe(track);
    measure();
  }

  // ── Lightbox ──
  const lightbox  = document.getElementById('lightbox') as HTMLElement | null;
  const lightImg  = lightbox?.querySelector('img') as HTMLImageElement | null;
  const zoomables = document.querySelectorAll<HTMLImageElement>('.diptych img, .triple img');

  function openLightbox(src: string, alt: string) {
    if (!lightbox || !lightImg) return;
    lightImg.src = src;
    lightImg.alt = alt;
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox || !lightImg) return;
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  }

  zoomables.forEach(img => {
    img.addEventListener('click', () => openLightbox(img.src, img.alt));
  });

  lightbox?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
