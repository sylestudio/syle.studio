---
import ProyectoBase from "../../layouts/ProyectoBase.astro";
import StaticPicture from "../../components/StaticPicture.astro";
---

<ProyectoBase
  title="DGX Archive"
  description="Sesión fotográfica de Syle Studio para DGX Archive: streetwear, long sleeves y un entorno que forma parte de la identidad de cada prenda."
  image="/img/DGX/Portada.jpg"
>
  <div class="hero-fixed">
    <StaticPicture src="/img/DGX/Portada.jpg" alt="DGX Archive" eager fill />
  </div>

  <div class="page-wrap">
    <main>

      <div class="wrap" data-scroll-text>
        <header class="pg-head">
          <h1 class="disp pg-title">DGX Archive</h1>
          <p class="pg-meta lbl muted">Fotografía - 2026</p>
        </header>
      </div>

      <!-- ── Intro grid ──────────────────────────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="intro-grid">
          <div class="intro-left">
            <h2 class="disp intro-h">DGX Archive</h2>
            <p class="body-s">
              DGX Archive es una marca enfocada en el streetwear, con una
              identidad tan firme que sus piezas terminaron vistiendo a artistas
              que están a la altura de la misma marca. Cada drop se piensa como
              archivo: prendas que se guardan, se heredan y siguen contando algo
              tiempo después.
            </p>
          </div>
          <div class="intro-right">
            <h2 class="disp intro-h">Sesión Fotográfica</h2>
            <span class="lbl muted">2026</span>
          </div>
        </div>
      </div>

      <!-- ── Diptych ────────────────────────────────────────── -->
      <div class="diptych">
        <StaticPicture src="/img/DGX/DGX_2.jpg" alt="Sesión de DGX Archive, imagen 1" sizes="(min-width: 769px) 50vw, 100vw" />
        <StaticPicture src="/img/DGX/DGX_3.jpg" alt="Sesión de DGX Archive, imagen 2" sizes="(min-width: 769px) 50vw, 100vw" />
      </div>

      <!-- ── Texto de la derecha ───────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="text-r">
          <h2 class="disp sub2-h">Las Long Sleeve</h2>
          <p class="body-s">
            Nuestra participación fue la fotografía de unas long sleeve que
            cargan una historia muy propia. Antes de disparar quisimos
            entenderla: de dónde salía el diseño y qué debía sentir quien la
            viera puesta.
          </p>
        </div>
      </div>

      <!-- ── Triple imágenes ────────────────────────────────── -->
      <div class="triple">
        <StaticPicture src="/img/DGX/DGX_1.jpg" alt="Sesión de DGX Archive, imagen 3" sizes="(min-width: 769px) 34vw, 100vw" />
        <StaticPicture src="/img/DGX/DGX_4.jpg" alt="Sesión de DGX Archive, imagen 4" sizes="(min-width: 769px) 34vw, 100vw" />
        <StaticPicture src="/img/DGX/DGX_5.jpg" alt="Sesión de DGX Archive, imagen 5" sizes="(min-width: 769px) 34vw, 100vw" />
      </div>

      <!-- ── Texto centrado ─────────────────────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="text-c">
          <h2 class="disp center-h">El Entorno</h2>
          <p class="body-s">
            Buscamos el lugar exacto para que todo cerrara: texturas, luz y
            desgaste que hablaran el mismo idioma que la prenda. El entorno no
            fue un fondo, fue parte del proyecto — lo que terminó de darle a las
            fotos la misma estética que la marca ya tenía.
          </p>
        </div>
      </div>

      <!-- ── Slider ─────────────────────────────────────────── -->
      <div class="slider-wrap" role="region" aria-roledescription="carrusel" aria-label="Fotografías de DGX Archive">
        <div class="slider" id="slider">
          <div class="slide active" aria-hidden="false"><StaticPicture src="/img/DGX/DGX_6.jpg" alt="DGX Archive, fotografía 1 de 4" fill /></div>
          <div class="slide" aria-hidden="true"><StaticPicture src="/img/DGX/DGX_9.jpg" alt="DGX Archive, fotografía 2 de 4" fill /></div>
          <div class="slide" aria-hidden="true"><StaticPicture src="/img/DGX/DGX_8.jpg" alt="DGX Archive, fotografía 3 de 4" fill /></div>
          <div class="slide" aria-hidden="true"><StaticPicture src="/img/DGX/DGX_7.jpg" alt="DGX Archive, fotografía 4 de 4" fill /></div>
        </div>
        <button type="button" class="sl-btn sl-prev" aria-label="Imagen anterior">&#8592;</button>
        <button type="button" class="sl-btn sl-next" aria-label="Imagen siguiente">&#8594;</button>
        <div class="sl-dots">
          <button type="button" class="dot active" data-i="0" aria-label="Mostrar imagen 1" aria-current="true"></button>
          <button type="button" class="dot" data-i="1" aria-label="Mostrar imagen 2" aria-current="false"></button>
          <button type="button" class="dot" data-i="2" aria-label="Mostrar imagen 3" aria-current="false"></button>
          <button type="button" class="dot" data-i="3" aria-label="Mostrar imagen 4" aria-current="false"></button>
        </div>
        <button type="button" class="sl-toggle" aria-controls="slider">Pausar presentación</button>
      </div>

      <!-- ── Créditos ───────────────────────────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="credits">
          <div class="credit-col">
            <span class="lbl muted">Proyecto</span>
            <a href="https://www.instagram.com/dgx.archive/" class="ln credit-val disp">DGX Archive</a>
          </div>
          <div class="credit-col">
            <span class="lbl muted">Fotografía / Diseño</span>
            <a href="https://www.instagram.com/dxniel.py/" class="ln credit-val">Dxniel.py</a>
            <a href="https://www.instagram.com/byxmmxx/" class="ln credit-val">Emma Acosta</a>
          </div>
          <div class="credit-col">
            <span class="lbl muted">Colaboración</span>
            <a href="https://www.instagram.com/dgx.archive/" class="ln credit-val">DGX Archive</a>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- ── Lightbox ── -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Vista ampliada" aria-hidden="true">
    <button class="lightbox-close" type="button" aria-label="Cerrar imagen ampliada">×</button>
    <img alt="" />
  </div>
</ProyectoBase>

<style>
  .muted { color: rgba(22, 20, 15, 0.68); }

  /* ── Shell ── */
  .hero-fixed {
    position: fixed;
    inset: 0;
    z-index: 0;
  }
  .hero-fixed :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .page-wrap {
    position: relative;
    z-index: 1;
    margin-top: 100vh;
    background: var(--paper);
  }

  .wrap {
    max-width: var(--shell-max);
    margin: 0 auto;
    padding-left: var(--page-gutter);
    padding-right: var(--page-gutter);
    background: var(--paper);
  }

  /* ── Header ── */
  .pg-head {
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    padding-top: 10rem;
    padding-bottom: 5rem;
    display: grid;
    gap: 1.25rem;
  }
  .pg-title {
    font-size: var(--type-page);
    line-height: 0.88;
  }

  /* ── Intro grid ── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding-bottom: 5rem;
  }
  .intro-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .intro-right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
  }
  .intro-h {
    font-size: var(--type-heading);
  }

  .body-s {
    font-size: var(--type-body-sm);
    line-height: 1.65;
    color: rgba(22, 20, 15, 0.72);
  }

  /* ── Diptych ── */
  .diptych {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
  }
  .diptych :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  /* ── Text right ── */
  .text-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    padding-top: 5rem;
    padding-bottom: 5rem;
    margin-left: auto;
    max-width: 60%;
  }
  .sub2-h {
    font-size: var(--type-heading);
    margin-bottom: 1.5rem;
  }
  .text-r .body-s { max-width: 44ch; }

  /* ── Texto centrado ── */
  .text-c {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 6rem;
    padding-bottom: 6rem;
  }
  .center-h {
    font-size: var(--type-heading);
    margin-bottom: 1.5rem;
  }
  .text-c .body-s { max-width: 52ch; }

  /* ── Triple ── */
  .triple {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 3px;
    align-items: start;
  }
  .triple :global(img) {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 3 / 4;
  }

  /* ── Slider ── */
  .slider-wrap {
    position: relative;
    margin-top: 8rem;
  }
  .slider {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .slide.active { opacity: 1; }
  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sl-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(22,20,15,0.45);
    color: #fff;
    border: none;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.1rem;
    cursor: pointer;
    z-index: 2;
    transition: background 0.2s;
  }
  .sl-btn:hover { background: rgba(22,20,15,0.75); }
  .sl-prev { left: 1rem; }
  .sl-next { right: 1rem; }
  .sl-dots {
    display: flex;
    justify-content: center;
    gap: 0.125rem;
    padding: 1rem 0;
  }
  .dot {
    padding: 0;
    border: 0;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    background: transparent;
    cursor: pointer;
  }
  .dot::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(22,20,15,0.25);
    transition: background 0.2s;
  }
  .dot.active::before { background: rgba(22,20,15,0.75); }
  .sl-toggle {
    display: block;
    margin: 0 auto;
    padding: 0.5rem 1rem;
    border: 1px solid currentColor;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--type-body-sm);
    cursor: pointer;
  }
  .dot:focus-visible,
  .sl-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  /* ── Créditos ── */
  .credits {
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    margin-top: 4rem;
    padding-top: 3rem;
    padding-bottom: 6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    justify-content: space-between;
  }
  .credit-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .credit-val {
    width: fit-content;
    font-size: var(--type-body);
  }
  .credit-val.disp {
    font-size: var(--type-title-sm);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .intro-right {
      align-items: flex-start;
      flex-direction: row;
      justify-content: space-between;
    }
    .diptych {
      grid-template-columns: 1fr;
    }
    .text-r {
      max-width: 100%;
      align-items: flex-start;
      text-align: left;
    }
    .triple {
      grid-template-columns: 1fr;
    }

    .diptych :global(img),
    .triple :global(img) {
      width: 100%;
      height: auto;
      aspect-ratio: auto;
      object-fit: contain;
    }
  }

  /* ── Hover discreto + zoom al click ── */
  .diptych :global(img),
  .triple :global(img) {
    cursor: zoom-in;
    transition: filter 0.35s ease, transform 0.35s ease;
  }
  .diptych :global(img:hover),
  .triple :global(img:hover) {
    filter: brightness(1.05);
    transform: scale(1.012);
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 4rem);
    background: rgba(16, 14, 10, 0.82);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    cursor: zoom-out;
  }
  .lightbox.open {
    opacity: 1;
    visibility: visible;
  }
  .lightbox img {
    max-width: min(90vw, 1100px);
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    transform: scale(0.96);
    transition: transform 0.3s ease;
  }
  .lightbox.open img { transform: scale(1); }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .lightbox,
    .lightbox img,
    .diptych :global(img),
    .triple :global(img) { transition: none; }
    .diptych :global(img:hover),
    .triple :global(img:hover) { transform: none; }
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.slide');
  const dots   = document.querySelectorAll<HTMLButtonElement>('.dot');
  const toggle = document.querySelector<HTMLButtonElement>('.sl-toggle');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let cur = 0;
  let paused = reducedMotion.matches;
  let timer: number | undefined;

  function goTo(n: number) {
    if (!slides.length) return;
    slides[cur].classList.remove('active');
    dots[cur].classList.remove('active');
    cur = (n + slides.length) % slides.length;
    slides[cur].classList.add('active');
    dots[cur].classList.add('active');
    dots.forEach((dot, index) => dot.setAttribute('aria-current', String(index === cur)));
    slides.forEach((slide, index) => slide.setAttribute('aria-hidden', String(index !== cur)));
  }

  function updatePlayback() {
    window.clearInterval(timer);
    timer = undefined;
    if (!paused && !document.hidden && slides.length > 1) {
      timer = window.setInterval(() => goTo(cur + 1), 4000);
    }
    if (toggle) toggle.textContent = paused ? 'Reproducir presentación' : 'Pausar presentación';
  }

  function navigate(n: number) {
    paused = true;
    updatePlayback();
    goTo(n);
  }

  document.querySelector('.sl-prev')?.addEventListener('click', () => navigate(cur - 1));
  document.querySelector('.sl-next')?.addEventListener('click', () => navigate(cur + 1));
  dots.forEach(d => d.addEventListener('click', () => navigate(Number(d.dataset.i))));
  toggle?.addEventListener('click', () => {
    paused = !paused;
    updatePlayback();
  });
  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) paused = true;
    updatePlayback();
  });
  document.addEventListener('visibilitychange', updatePlayback);
  updatePlayback();

  // ── Lightbox ──
  const lightbox  = document.getElementById('lightbox') as HTMLElement | null;
  const lightImg  = lightbox?.querySelector('img') as HTMLImageElement | null;
  const zoomables = document.querySelectorAll<HTMLImageElement>('.diptych img, .triple img');

  function openLightbox(src: string, alt: string) {
    if (!lightbox || !lightImg) return;
    lightImg.src = src;
    lightImg.alt = alt;
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox || !lightImg) return;
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  }

  zoomables.forEach(img => {
    img.addEventListener('click', () => openLightbox(img.src, img.alt));
  });

  lightbox?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
