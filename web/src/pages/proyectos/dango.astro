---
import ProyectoBase from "../../layouts/ProyectoBase.astro";
import StaticPicture from "../../components/StaticPicture.astro";
---

<ProyectoBase
  title="Dango"
  description="Dirección creativa y registro visual de la participación de Syle Studio como sponsor del Festival Dango en Teotihuacán."
  image="/img/Dango/Main.jpg"
>
  <div class="hero-fixed">
    <StaticPicture src="/img/Dango/Main.jpg" alt="Dango" eager fill />
  </div>

  <div class="page-wrap">
    <main>

      <div class="wrap" data-scroll-text>
        <header class="pg-head">
          <span class="lbl muted">SYLE · 002</span>
          <h1 class="disp pg-title">Festival Dango</h1>
          <p class="pg-meta lbl muted">Sponsor - 2026</p>
        </header>
      </div>

      <!-- ── Intro grid ──────────────────────────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="intro-grid">
          <div class="intro-left">
            <h2 class="disp intro-h">Sponsors en Festival Dango</h2>
            <p class="body-s">
              Dango fue un festival de música del cual pudimos formar parte como
              sponsors, el festival tuvo sede en Teotihuacan, se presentaron
              artistas Mexicanos recoconocidos dentro del ambito del reggeaton, rock indie y
              otros generos.
            </p>
          </div>
          <div class="intro-right">
            <h2 class="disp intro-h">Syle Studio</h2>
            <span class="lbl muted">2025</span>
          </div>
        </div>
      </div>

      <!-- ── Mampostería horizontal (avanza con el scroll) ──── -->
      <section class="hscroll">
        <div class="hscroll-pin">
          <div class="masonry-track" id="masonry">
            <!-- ESPACIO con imagen VERTICAL (retrato): una sola foto llena el slot.
                 Cuando tengas verticales, úsalas así:
            <div class="slot">
              <StaticPicture src="/img/Dango/Manposteria/TuVertical.jpg" alt="" sizes="70vw" fill />
            </div>
            -->
          <div class="slot">
              <StaticPicture src="/img/Dango/Manposteria/Man_2.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot">
              <StaticPicture src="/img/Dango/Manposteria/Man_4.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot slot--stack">
              <StaticPicture src="/img/Dango/Manposteria/Man_11.jpg" alt="" sizes="70vw" fill />
              <StaticPicture src="/img/Dango/Manposteria/Man_12.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot">
              <StaticPicture src="/img/Dango/Manposteria/Man_8.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot">
              <StaticPicture src="/img/Dango/Manposteria/Man_5.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot slot--stack">
              <StaticPicture src="/img/Dango/Manposteria/Man_13.jpg" alt="" sizes="70vw" fill />
              <StaticPicture src="/img/Dango/Manposteria/Man_14.jpg" alt="" sizes="70vw" fill />
          </div>
          <div class="slot">
              <StaticPicture src="/img/Dango/Manposteria/Man_6.jpg" alt="" sizes="70vw" fill />
          </div>
            <!-- ESPACIO con 2 HORIZONTALES apiladas (mismo tamaño que un slot vertical) -->

          </div>
        </div>
      </section>

      <!-- ── Texto de la derecha ───────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="text-r">
          <h2 class="disp sub2-h">Estetica del Proyecto</h2>
          <p class="body-s">
            Durante la elaboracion de todo este proyecto buscamos mantener
            una estetica acorde a la idea de nuestro proyecto, la idea de las
            locaciones, los colores, y la edicion de las fotos buscaba una idea
            agresiva, contrastada con colores limpios donde se enfatizara la otra
            contra parte del significado.
          </p>
        </div>
      </div>

      <!-- ── Triple imágenes ────────────────────────────────── -->
      <div class="triple">
        <StaticPicture src="/img/Dango/Logo_1.jpg" alt="" sizes="(min-width: 700px) 34vw, 100vw" />
        <StaticPicture src="/img/Dango/Logo_2.jpg" alt="" sizes="(min-width: 700px) 34vw, 100vw" />
        <StaticPicture src="/img/Dango/Logo_4.jpg" alt="" sizes="(min-width: 700px) 34vw, 100vw" />
      </div>

      <!-- ── Texto centrado ─────────────────────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="text-c">
          <h2 class="disp center-h">El Proceso</h2>
          <p class="body-s">
            Cada prenda y cada toma nacieron de un proceso colaborativo donde
            la experimentacion fue la constante. Llevamos la idea del simbolo
            mas alla de la prenda, construyendo una narrativa visual completa
            que conecta el concepto con la estetica final del proyecto.
          </p>
        </div>
      </div>

      <!-- ── Diptych ────────────────────────────────────────── -->
      <div class="diptych">
        <StaticPicture src="/img/Dango/Logo_5.jpg" alt="" sizes="(min-width: 700px) 50vw, 100vw" />
        <StaticPicture src="/img/Dango/Logo_3.jpg" alt="" sizes="(min-width: 700px) 50vw, 100vw" />
      </div>

      <!-- ── Créditos ───────────────────────────────────────── -->
      <div class="wrap" data-scroll-text>
        <div class="credits">
          <div class="credit-col">
            <span class="lbl muted">Proyecto</span>
            <span class="credit-val disp">Dango</span>
          </div>
          <div class="credit-col">
            <span class="lbl muted">Fotografía</span>
            <a href="https://www.instagram.com/dxniel.py/" class="ln credit-val">Daijin</a>
            <a href="https://www.instagram.com/pipian.syle/" class="ln credit-val">Angel Torres</a>
            <a href="https://www.instagram.com/byxmmxx/" class="ln credit-val">Emma Acosta</a>
            <a href="https://www.instagram.com/ag_palacios_z/" class="ln credit-val">Angel Gael</a>
          </div>
          <div class="credit-col">
            <span class="lbl muted">Diseno</span>
            <a href="https://www.instagram.com/dxniel.py/" class="ln credit-val">Daijin</a>
          </div>
           <div class="credit-col">
            <span class="lbl muted">Sponsor con</span>
            <a href="https://www.instagram.com/festivaldango/" class="ln credit-val">Festival Dango</a>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- ── Lightbox ── -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Vista ampliada" aria-hidden="true">
    <button class="lightbox-close" type="button" aria-label="Cerrar imagen ampliada">×</button>
    <img alt="" />
  </div>
</ProyectoBase>

<style>
  .muted { color: rgba(22, 20, 15, 0.68); }

  /* ── Shell ── */
  .hero-fixed {
    position: fixed;
    inset: 0;
    z-index: 0;
  }
  .hero-fixed :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .page-wrap {
    position: relative;
    z-index: 1;
    margin-top: 100vh;
    background: var(--paper);
  }

  .wrap {
    max-width: 1700px;
    margin: 0 auto;
    padding-left: clamp(1.5rem, 3vw, 3rem);
    padding-right: clamp(1.5rem, 3vw, 3rem);
  }

  /* ── Header ── */
  .pg-head {
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    padding-top: 10rem;
    padding-bottom: 5rem;
    display: grid;
    gap: 1.25rem;
  }
  .pg-title {
    font-size: clamp(3rem, 10vw, 9rem);
    line-height: 0.88;
  }

  /* ── Intro grid ── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding-bottom: 5rem;
  }
  .intro-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .intro-right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
  }
  .intro-h {
    font-size: clamp(1.75rem, 4vw, 4.5rem);
  }

  .body-s {
    font-size: clamp(0.7rem, 1.1vw, 0.85rem);
    line-height: 1.65;
    color: rgba(22, 20, 15, 0.72);
  }

  /* ── Diptych ── */
  .diptych {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    margin-top: 8rem;
  }
  .diptych :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  /* ── Text right ── */
  .text-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    padding-top: 5rem;
    padding-bottom: 5rem;
    margin-left: auto;
    max-width: 60%;
  }
  .sub2-h {
    font-size: clamp(1.75rem, 4vw, 4.5rem);
    margin-bottom: 1.5rem;
  }
  .text-r .body-s { max-width: 44ch; }

  /* ── Texto centrado ── */
  .text-c {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 6rem;
    padding-bottom: 6rem;
  }
  .center-h {
    font-size: clamp(1.75rem, 4vw, 4.5rem);
    margin-bottom: 1.5rem;
  }
  .text-c .body-s { max-width: 52ch; }

  /* ── Triple ── */
  .triple {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 3px;
    align-items: start;
  }
  .triple :global(img) {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 3 / 4;
  }

  /* ── Mampostería horizontal (avanza con el scroll) ──
     Estado base = fallback: tira con scroll horizontal manual. Es lo que queda
     sin JS o con reduced motion, y siempre es usable (se arrastra con el dedo).
     Con JS el script añade .is-pinned y la sección pasa a "pinearse": la tira
     avanza de izquierda a derecha mientras bajas.

     Antes el pin salía de `animation-timeline: view()` y ahí estaba el bug de
     móvil: los navegadores sin scroll-driven animations caían al fallback,
     pero el propio @supports ya les había puesto overflow:hidden en el pin, así
     que la tira ni avanzaba con el scroll ni se dejaba arrastrar — estática.
     Ahora el recorrido lo calcula el script, igual en todos los navegadores. */
  .hscroll {
    position: relative;
  }
  .hscroll-pin {
    overflow-x: auto;
    overflow-y: hidden;
  }
  .masonry-track {
    display: flex;
    gap: 3px;
    width: max-content;
  }
  /* Sistema de ESPACIOS: cada slot mide exactamente lo mismo.
     - .slot          → 1 imagen vertical (retrato) que llena el espacio
     - .slot--stack   → 2 imágenes horizontales apiladas en el mismo espacio */
  .slot {
    flex: 0 0 auto;
    /* más alto → verticales más largas. dvh para que el slot quepa dentro del
       pin (100dvh) aunque la barra de URL esté visible; vh queda de fallback */
    height: 82vh;
    height: 82dvh;
    width: 46vh;          /* más angosto → formato retrato más estilizado */
  }
  .slot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;     /* la vertical llena el espacio sin deformar */
    display: block;
  }
  /* ESPACIO de 2 horizontales: mismo alto que el slot vertical, pero más ANCHO
     (ancho fijo ~3:2 a media altura) para que la horizontal entre completa
     sin recortarse a lo ancho y sin romper la cuadrícula. */
  .slot--stack {
    width: 62vh;
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 3px;              /* el gap se descuenta del alto automáticamente */
  }

  /* Pin + desplazamiento horizontal. El script mide el recorrido que le sobra
     a la tira y lo publica en --travel; la sección reserva ese alto extra, así
     que 1px de scroll = 1px de avance lateral y el ritmo se ajusta solo al
     número de slots y al tamaño de pantalla (ya no hace falta el 360vh/480vh
     a ojo, que era lo que descuadraba el final de la tira en móvil).

     dvh y no vh: con la barra de URL visible 100vh es MÁS alto que el área
     realmente visible, así que el pin se salía de cuadro justo en móvil. La
     declaración vh queda debajo como fallback para navegadores sin dvh. */
  .hscroll.is-pinned {
    height: calc(100vh + var(--travel, 0px));
    height: calc(100dvh + var(--travel, 0px));
  }
  .hscroll.is-pinned .hscroll-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .hscroll.is-pinned .masonry-track { will-change: transform; }

  /* Accesibilidad: sin pin si el usuario pide reduced motion. El script ya no
     lo activa; esto cubre además que se cambie la preferencia tras la carga. */
  @media (prefers-reduced-motion: reduce) {
    .hscroll.is-pinned { height: auto; }
    .hscroll.is-pinned .hscroll-pin {
      position: static;
      height: auto;
      overflow-x: auto;
    }
    .hscroll.is-pinned .masonry-track { transform: none; }
  }

  /* ── Créditos ── */
  .credits {
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    margin-top: 4rem;
    padding-top: 3rem;
    padding-bottom: 6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    justify-content: space-between;
  }
  .credit-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .credit-val {
    width: fit-content;
    font-size: 1rem;
  }
  .credit-val.disp {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .intro-right {
      align-items: flex-start;
      flex-direction: row;
      justify-content: space-between;
    }
    .diptych {
      grid-template-columns: 1fr;
    }
    .text-r {
      max-width: 100%;
      align-items: flex-start;
      text-align: left;
    }
    .triple {
      grid-template-columns: 1fr;
    }

    /* en móvil cada ESPACIO ocupa casi toda la pantalla. dvh para que el slot
       quepa dentro del pin aunque la barra de URL esté visible; el recorrido
       total ya lo calcula el script. */
    .slot {
      height: 82vh;
      height: 82dvh;
      width: 92vw;
    }

    /* Mostrar las fotos completas en móvil, sin recorte */
    .diptych :global(img),
    .triple :global(img) {
      width: 100%;
      height: auto;
      aspect-ratio: auto;
      object-fit: contain;
    }
  }

  /* ── Hover discreto + zoom al click ── */
  .diptych :global(img),
  .triple :global(img) {
    cursor: zoom-in;
    transition: filter 0.35s ease, transform 0.35s ease;
  }
  .diptych :global(img:hover),
  .triple :global(img:hover) {
    filter: brightness(1.05);
    transform: scale(1.012);
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 4rem);
    background: rgba(16, 14, 10, 0.82);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    cursor: zoom-out;
  }
  .lightbox.open {
    opacity: 1;
    visibility: visible;
  }
  .lightbox img {
    max-width: min(90vw, 1100px);
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    transform: scale(0.96);
    transition: transform 0.3s ease;
  }
  .lightbox.open img { transform: scale(1); }
</style>

<script>
  // ── Mampostería horizontal ──
  // La tira avanza en horizontal mientras la sección está pineada. Va por JS y
  // no por `animation-timeline: view()` para que se comporte igual en todos
  // los navegadores: ese camino no existe en Safari iOS antiguo ni en Firefox,
  // y ahí la sección se quedaba estática.
  //
  // Se publica el recorrido en --travel y la sección reserva ese alto de más,
  // de forma que el tramo pineado dura exactamente lo que mide la tira.
  const hscroll = document.querySelector<HTMLElement>('.hscroll');
  const track = document.getElementById('masonry');
  const noMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hscroll && track && !noMotion) {
    hscroll.classList.add('is-pinned');

    let travel = 0;
    let queued = false;

    const place = () => {
      queued = false;
      // -top va de 0 (la sección toca el borde superior y empieza el pin) a
      // travel (se agota el recorrido y la sección se despega)
      const p = Math.min(Math.max(-hscroll.getBoundingClientRect().top, 0), travel);
      track.style.transform = `translate3d(${-p}px, 0, 0)`;
    };

    const measure = () => {
      const next = Math.max(0, track.scrollWidth - hscroll.clientWidth);
      if (next !== travel) {
        travel = next;
        hscroll.style.setProperty('--travel', `${travel}px`);
      }
      place();
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(place);
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', measure);
    // los slots miden en vh/vw, pero el RO cubre además cambios de layout que
    // no vienen de un resize (fuentes, imágenes que aún no habían cargado)
    if ('ResizeObserver' in window) new ResizeObserver(measure).observe(track);
    measure();
  }

  // ── Lightbox ──
  const lightbox  = document.getElementById('lightbox') as HTMLElement | null;
  const lightImg  = lightbox?.querySelector('img') as HTMLImageElement | null;
  const zoomables = document.querySelectorAll<HTMLImageElement>('.diptych img, .triple img');

  function openLightbox(src: string, alt: string) {
    if (!lightbox || !lightImg) return;
    lightImg.src = src;
    lightImg.alt = alt;
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox || !lightImg) return;
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  }

  zoomables.forEach(img => {
    img.addEventListener('click', () => openLightbox(img.src, img.alt));
  });

  lightbox?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
