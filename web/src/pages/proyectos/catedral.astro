---
import Base from "../../layouts/Base.astro";
---

<Base title="Catedral" bare>
  <div class="hero-fixed">
    <img src="/img/Simbolo/Simbolo.jpg" alt="Catedral" />
  </div>

  <div class="page-wrap">
    <main>

      <div class="wrap">
        <header class="pg-head">
          <span class="lbl muted">SYL · 001</span>
          <h1 class="disp pg-title">Catedral</h1>
          <p class="pg-meta lbl muted">35mm — 2025</p>
        </header>
      </div>

      <!-- ── Intro grid ──────────────────────────────────────── -->
      <div class="wrap">
        <div class="intro-grid">
          <div class="intro-left">
            <h2 class="disp intro-h">Simbolo Vivo</h2>
            <p class="body-s">
              Visual identity for Gilga Farm, Donald Glover's creative studio
              and artistic sanctuary located in Ojai, California.<br />
              Both a functioning farm and a multidisciplinary incubator, Gilga
              Farm serves as a production company, cultural library, and
              collaborative space where creators from diverse backgrounds
              come together to explore and experiment freely.
            </p>
          </div>
          <div class="intro-right">
            <h2 class="disp intro-h">Syle Studio</h2>
            <span class="lbl muted">2025</span>
          </div>
        </div>
      </div>

      <!-- ── Diptych ────────────────────────────────────────── -->
      <div class="diptych">
        <img src="/img/hero.webp" alt="" />
        <img src="/img/about-manifiesto-2.webp" alt="" />
      </div>

      <!-- ── Subtitulo 2 (texto derecha) ───────────────────── -->
      <div class="wrap">
        <div class="text-r">
          <h2 class="disp sub2-h">Subtitulo 2</h2>
          <p class="body-s">
            Visual identity for Gilga Farm, Donald Glover's creative studio
            and artistic sanctuary located in Ojai, California.<br />
            Both a functioning farm and a multidisciplinary incubator, Gilga
            Farm serves as a production company, cultural library, and
            collaborative space where creators from diverse backgrounds
            come together to explore and experiment freely.
          </p>
        </div>
      </div>

      <!-- ── Triple imágenes ────────────────────────────────── -->
      <div class="triple">
        <img src="/img/about-manifiesto-2.webp" alt="" />
        <img src="/img/Simbolo/Simbolo.jpg" alt="" />
        <img src="/img/hero.webp" alt="" />
      </div>

      <!-- ── Slider ─────────────────────────────────────────── -->
      <div class="slider">
        <img src="/img/hero.webp" alt="" />
      </div>

    </main>
  </div>
</Base>

<style>
  .muted { color: rgba(22, 20, 15, 0.42); }

  /* ── Shell ── */
  .hero-fixed {
    position: fixed;
    inset: 0;
    z-index: 0;
  }
  .hero-fixed img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .page-wrap {
    position: relative;
    z-index: 1;
    margin-top: 100vh;
    background: var(--paper);
  }

  .wrap {
    max-width: 1700px;
    margin: 0 auto;
    padding-left: clamp(1.5rem, 3vw, 3rem);
    padding-right: clamp(1.5rem, 3vw, 3rem);
  }

  /* ── Header ── */
  .pg-head {
    border-top: 1px solid rgba(22, 20, 15, 0.15);
    padding-top: 10rem;
    padding-bottom: 5rem;
    display: grid;
    gap: 1.25rem;
  }
  .pg-title {
    font-size: clamp(3rem, 10vw, 9rem);
    line-height: 0.88;
  }

  /* ── Intro grid ── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding-bottom: 5rem;
  }
  .intro-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .intro-right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
  }
  .intro-h {
    font-size: clamp(1.75rem, 4vw, 4.5rem);
  }

  .body-s {
    font-size: clamp(0.7rem, 1.1vw, 0.85rem);
    line-height: 1.65;
    color: rgba(22, 20, 15, 0.72);
  }

  /* ── Diptych ── */
  .diptych {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
  }
  .diptych img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  /* ── Text right ── */
  .text-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    padding-top: 5rem;
    padding-bottom: 5rem;
    margin-left: auto;
    max-width: 60%;
  }
  .sub2-h {
    font-size: clamp(1.75rem, 4vw, 4.5rem);
    margin-bottom: 1.5rem;
  }
  .text-r .body-s { max-width: 44ch; }

  /* ── Triple ── */
  .triple {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 3px;
    align-items: start;
  }
  .triple img {
    width: 100%;
    display: block;
    object-fit: cover;
  }
  .triple img:nth-child(1) { aspect-ratio: 3 / 4; }
  .triple img:nth-child(2) { aspect-ratio: 2 / 4; }
  .triple img:nth-child(3) { aspect-ratio: 3 / 4; }

  /* ── Slider ── */
  .slider {
    margin-top: 8rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .slider img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .intro-right {
      align-items: flex-start;
      flex-direction: row;
      justify-content: space-between;
    }
    .diptych {
      grid-template-columns: 1fr;
    }
    .text-r {
      max-width: 100%;
      align-items: flex-start;
      text-align: left;
    }
    .triple {
      grid-template-columns: 1fr 1fr;
    }
    .triple img:nth-child(2) {
      grid-column: span 2;
      aspect-ratio: 16 / 9;
    }
  }
</style>
