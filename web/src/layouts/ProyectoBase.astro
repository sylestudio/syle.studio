---
import Base from "./Base.astro";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description, image } = Astro.props;
---

<Base title={title} description={description} image={image} initialNavDark bare>
  <div class="syle-watermark" aria-hidden="true">
    <Wordmark class="watermark-wordmark" />
    <span class="wm-t"></span>
    <span class="wm-r"></span>
    <span class="wm-b"></span>
    <span class="wm-l"></span>
  </div>
  <slot />
</Base>

<style>
  .syle-watermark {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70vw;
    max-width: 1100px;
    opacity: 0.035;
    pointer-events: none;
    z-index: 2;
    user-select: none;
    color: var(--ink);
  }
  .syle-watermark :global(.watermark-wordmark) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Four sides drawn clockwise: top → right → bottom → left */
  .wm-t, .wm-r, .wm-b, .wm-l { position: absolute; background: #16140f; }

  .wm-t {
    top: -10px; left: -10px; right: -10px; height: 1px;
    transform: scaleX(0); transform-origin: left center;
    animation: grow-x 0.45s cubic-bezier(0.32, 0.72, 0, 1) 0.4s forwards;
  }
  .wm-r {
    top: -10px; bottom: -10px; right: -10px; width: 1px;
    transform: scaleY(0); transform-origin: top center;
    animation: grow-y 0.45s cubic-bezier(0.32, 0.72, 0, 1) 0.8s forwards;
  }
  .wm-b {
    bottom: -10px; left: -10px; right: -10px; height: 1px;
    transform: scaleX(0); transform-origin: right center;
    animation: grow-x 0.45s cubic-bezier(0.32, 0.72, 0, 1) 1.2s forwards;
  }
  .wm-l {
    top: -10px; bottom: -10px; left: -10px; width: 1px;
    transform: scaleY(0); transform-origin: bottom center;
    animation: grow-y 0.45s cubic-bezier(0.32, 0.72, 0, 1) 1.6s forwards;
  }

  @keyframes grow-x { to { transform: scaleX(1); } }
  @keyframes grow-y { to { transform: scaleY(1); } }

  :global(.lightbox-close) {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(244, 241, 234, 0.55);
    border-radius: 999px;
    background: rgba(12, 11, 10, 0.72);
    color: var(--paper);
    font: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  :global(.lightbox [role="button"]:focus-visible),
  :global(.lightbox-close:focus-visible) {
    outline-color: var(--paper);
  }
</style>

<script>
  // Existing project galleries share the same lightbox contract. Enhance it
  // once here so every zoomable image works with keyboard and restores focus.
  const dialog = document.getElementById("lightbox");
  const closeButton = dialog?.querySelector<HTMLButtonElement>(".lightbox-close");
  const zoomables = document.querySelectorAll<HTMLImageElement>(
    ".diptych img, .triple img, .gallery img",
  );
  let opener: HTMLElement | null = null;

  if (dialog && closeButton) {
    dialog.setAttribute("aria-hidden", "true");
    const projectName =
      document.querySelector("h1")?.textContent?.replace(/\s+/g, " ").trim() ||
      "proyecto";
    zoomables.forEach((image, index) => {
      const description = image.alt || `Imagen ${index + 1} de ${projectName}`;
      image.alt = description;
      image.tabIndex = 0;
      image.setAttribute("role", "button");
      image.setAttribute("aria-label", `Ampliar imagen: ${description}`);
      image.addEventListener("click", () => {
        opener = image;
      });
      image.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        image.click();
      });
    });

    closeButton.addEventListener("click", (event) => {
      event.stopPropagation();
      dialog.click();
    });
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Tab") {
        event.preventDefault();
        closeButton.focus();
      }
    });

    new MutationObserver(() => {
      const open = dialog.classList.contains("open");
      dialog.setAttribute("aria-hidden", String(!open));
      if (open) closeButton.focus();
      else opener?.focus();
    }).observe(dialog, { attributes: true, attributeFilter: ["class"] });
  }
</script>
