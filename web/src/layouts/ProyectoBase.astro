---
import Base from "./Base.astro";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description, image } = Astro.props;
---

<Base title={title} description={description} image={image} initialNavDark bare>
  <!-- El logotipo va INLINE, no como <img src="/Syle_Fuente_Negro.svg">: dentro
       de una imagen el navegador no expone los paths, asi que no habia nada que
       trazar y la marca se quedaba en un relleno a baja opacidad. Con el SVG en
       el documento (y `fill:none` + stroke, ver estilos) el script de abajo le
       recorre el contorno igual que las marcas de la home. -->
  <div class="syle-watermark" aria-hidden="true"><Wordmark /></div>
  <slot />
</Base>

<style>
  .syle-watermark {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70vw;
    max-width: 1100px;
    color: var(--ink);
    pointer-events: none;
    z-index: 2;
    user-select: none;
  }

  /* Trazo, no mancha: una silueta rellena no se puede "dibujar", asi que el
     logotipo se pinta como contorno para que el guion del script tenga por
     donde correr. `overflow: visible` para que los remates redondeados no se
     corten contra el borde del viewBox.
     La opacidad va baja a proposito: la marca vive por encima del contenido
     (z-index 2), no de fondo como las de la home — subir este valor la vuelve
     protagonista. */
  .syle-watermark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    opacity: 0.09;
  }
  .syle-watermark :global(path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 12;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  :global(.lightbox-close) {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(244, 241, 234, 0.55);
    border-radius: 999px;
    background: rgba(12, 11, 10, 0.72);
    color: var(--paper);
    font: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  :global(.lightbox [role="button"]:focus-visible),
  :global(.lightbox-close:focus-visible) {
    outline-color: var(--paper);
  }
</style>

<script>
  // Misma mecanica que las marcas de line-art de la home: un unico segmento
  // encendido recorre cada trazo para siempre — su borde delantero dibuja
  // linea nueva mientras el trasero borra por detras. Sin rebote: el periodo
  // del guion equivale al largo del path, asi que avanzar el offset en un solo
  // sentido cierra el bucle sin costura. La velocidad se interpola hacia un
  // objetivo aleatorio nuevo cada ~0.5-1.8s para acelerar y frenar de forma
  // organica, y cada uno de los cuatro trazos corre con su propia semilla para
  // que no vayan en formacion.
  // Aqui no hace falta el IntersectionObserver de la home: la marca es `fixed`,
  // no se sale de pantalla nunca (y con la pestana en segundo plano el propio
  // rAF deja de disparar).
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const paths = document.querySelectorAll<SVGGeometryElement>(
    ".syle-watermark path",
  );

  if (!reduce) {
    paths.forEach((path) => {
      const len = path.getTotalLength();
      const seg = len * 0.6; // fraccion encendida del trazo
      path.style.strokeDasharray = `${seg} ${len - seg}`;

      let offset = Math.random() * len; // arranque en un punto cualquiera
      const dir = Math.random() < 0.5 ? 1 : -1; // sentido fijo de viaje
      let speed = len * 0.16; // unidades de path / segundo
      let target = speed;
      let retargetAt = 0;
      let last = performance.now();

      const tick = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;

        if (now >= retargetAt) {
          target = len * (0.07 + Math.random() * 0.4); // nueva velocidad crucero
          retargetAt = now + 500 + Math.random() * 1300;
        }
        speed += (target - speed) * 0.05; // aproximacion suave, sin tirones

        offset += dir * speed * dt;
        offset = ((offset % len) + len) % len; // un periodo -> sin costura

        path.style.strokeDashoffset = String(offset);
        requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    });
  }

  // Existing project galleries share the same lightbox contract. Enhance it
  // once here so every zoomable image works with keyboard and restores focus.
  const dialog = document.getElementById("lightbox");
  const closeButton = dialog?.querySelector<HTMLButtonElement>(".lightbox-close");
  const zoomables = document.querySelectorAll<HTMLImageElement>(
    ".diptych img, .triple img, .gallery img",
  );
  let opener: HTMLElement | null = null;

  if (dialog && closeButton) {
    dialog.setAttribute("aria-hidden", "true");
    const projectName =
      document.querySelector("h1")?.textContent?.replace(/\s+/g, " ").trim() ||
      "proyecto";
    zoomables.forEach((image, index) => {
      const description = image.alt || `Imagen ${index + 1} de ${projectName}`;
      image.alt = description;
      image.tabIndex = 0;
      image.setAttribute("role", "button");
      image.setAttribute("aria-label", `Ampliar imagen: ${description}`);
      image.addEventListener("click", () => {
        opener = image;
      });
      image.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        image.click();
      });
    });

    closeButton.addEventListener("click", (event) => {
      event.stopPropagation();
      dialog.click();
    });
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Tab") {
        event.preventDefault();
        closeButton.focus();
      }
    });

    new MutationObserver(() => {
      const open = dialog.classList.contains("open");
      dialog.setAttribute("aria-hidden", String(!open));
      // Wait for the visibility transition to start before moving focus;
      // browsers cannot focus a control while its dialog is still hidden.
      if (open) requestAnimationFrame(() => requestAnimationFrame(() => {
        if (dialog.classList.contains("open")) closeButton.focus({ preventScroll: true });
      }));
      else opener?.focus();
    }).observe(dialog, { attributes: true, attributeFilter: ["class"] });
  }
</script>
