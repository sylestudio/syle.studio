---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · syle.studio</title>
    <style is:global>
      :root { color-scheme: light; }
      * { box-sizing: border-box; margin: 0; }
      body {
        font-family: ui-sans-serif, system-ui, sans-serif;
        color: #18181b;
        background: #fff;
        line-height: 1.5;
      }
      a { color: inherit; text-decoration: none; }
      .wrap { max-width: 72rem; margin: 0 auto; padding: 2rem 1.5rem; }
      header.site { display: flex; justify-content: space-between; align-items: baseline; }
      header.site h1 { font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em; }
      nav a { margin-left: 1.25rem; font-size: 0.875rem; color: #71717a; }
      img { display: block; width: 100%; height: auto; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a href="/"><h1>syle.studio</h1></a>
        <nav>
          <a href="/">Portafolio</a>
          <a href="/blog">Blog</a>
        </nav>
      </header>
      <main style="margin-top:2.5rem">
        <slot />
      </main>
    </div>
  </body>
</html>
