---
// Fixed nav that re-tones over dark sections (bitonal). The colour swap is a
// zero-animation class toggle driven by IntersectionObserver — no scroll
// handler, runs even with reduced motion. The liquid wordmark is the
// authoritative vector and inherits the nav's `currentColor`, so it re-tones
// with the same toggle — no CSS filter needed.
import Wordmark from "./Wordmark.astro";

interface Props {
  initialDark?: boolean;
}
const { initialDark = false } = Astro.props;
---

<nav id="nav" class:list={{ "on-dark": initialDark }}>
  <div class="nav-row">
    <a href="/" class="nav-mark-link" aria-label="syle.studio — inicio">
      <Wordmark class="nav-mark" />
    </a>
    <div class="nav-links lbl">
      <a href="/#proyectos">Proyectos</a>
      <a href="/blog/">Blog</a>
      <a href="/#contacto" class="ln">Contacto</a>
    </div>
  </div>
</nav>

<style>
  #nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--ink);
    transition: color 0.5s var(--e), transform 0.4s var(--e);
  }
  :global(#nav.nav--hidden) {
    transform: translateY(-110%);
  }
  .nav-row {
    max-width: var(--shell-max);
    margin: 0 auto;
    padding: 1.25rem var(--page-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  /* The wordmark is a child component, so its <svg> lives outside this file's
     scope — size it via :global() anchored to the (scoped) link. It inherits
     the nav's currentColor, which transitions on the dark-section toggle. */
  .nav-mark-link :global(.nav-mark) {
    height: 1.5rem;
    width: auto;
    display: block;
    transition: color 0.5s var(--e);
  }
  .nav-links {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }
  .nav-links a {
    opacity: 0.7;
    transition: opacity 0.4s var(--e);
  }
  .nav-links a:hover {
    opacity: 1;
  }
  /* dark-section state */
  :global(#nav.on-dark) {
    color: var(--paper);
  }
  @media (min-width: 768px) {
    .nav-mark-link :global(.nav-mark) {
      height: 1.75rem;
    }
  }
</style>

<script>
  const nav = document.getElementById("nav")!;
  let prev = window.scrollY;

  window.addEventListener("scroll", () => {
    const curr = window.scrollY;
    const delta = curr - prev;
    if (Math.abs(delta) < 4) return;
    nav.classList.toggle("nav--hidden", delta > 0 && curr > 80);
    prev = curr;
  }, { passive: true });
</script>
