---
// Fixed nav that re-tones over dark sections (bitonal). The colour swap is a
// zero-animation class toggle driven by IntersectionObserver — no scroll
// handler, runs even with reduced motion. Keeps the real liquid wordmark
// (logo-b.png) instead of a stand-in mark; it is inverted via CSS filter
// for the dark state.
---

<nav id="nav">
  <div class="nav-row">
    <a href="/" class="nav-mark-link" aria-label="syle.studio — inicio">
      <img src="/img/logo-b.png" alt="syle studio" class="nav-mark" width="120" height="36" />
    </a>
    <div class="nav-links lbl">
      <a href="/#proyectos">Proyectos</a>
      <a href="/blog">Blog</a>
      <a href="/#contacto" class="ln">Contacto</a>
    </div>
  </div>
</nav>

<style>
  #nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--ink);
    transition: color 0.5s var(--e);
  }
  .nav-row {
    max-width: 1700px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-mark {
    height: 1.5rem;
    width: auto;
    display: block;
    transition: filter 0.5s var(--e);
  }
  .nav-links {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }
  .nav-links a {
    opacity: 0.7;
    transition: opacity 0.4s var(--e);
  }
  .nav-links a:hover {
    opacity: 1;
  }
  /* dark-section state */
  :global(#nav.on-dark) {
    color: var(--paper);
  }
  :global(#nav.on-dark) .nav-mark {
    filter: invert(1);
  }
  @media (min-width: 768px) {
    .nav-row {
      padding: 1.25rem 3rem;
    }
    .nav-mark {
      height: 1.75rem;
    }
  }
</style>
