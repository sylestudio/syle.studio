---
import TheDashMark from "../assets/brand/the-dash-studios-mark.svg";
---

<footer class="site-footer">
  <div class="foot-inner">
    <!-- Wordmark -->
    <a href="/" class="foot-brand" aria-label="syle.studio">
      <img class="foot-fuente" src="/img/Syle_Fuente_Negro%20(1).svg" alt="SYLE" width="7872" height="2851" decoding="async" />
    </a>

    <!-- Sitio -->
    <a href="https://sylestudio.com" class="foot-site ln">SYLESTUDIO.COM</a>

    <!-- Instagram -->
    <a
      href="https://www.instagram.com/syle_studio/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
      class="foot-ig"
    >
      <img src="/img/instagram.svg" alt="Instagram" width="32" height="32" decoding="async" />
    </a>

    <!-- Símbolo -->
    <a href="/" class="foot-mark" aria-label="syle.studio">
      <img src="/img/Syle_Logo_Negro%20(1).svg" alt="Syle" width="5383" height="5059" decoding="async" />
    </a>
  </div>

  <div class="foot-signature">
    <a class="footer-affiliation" href="https://thedashstudios.mx/">
      <TheDashMark class="footer-affiliation__mark" width="32" height="32" aria-hidden="true" focusable="false" />
      <span class="footer-affiliation__copy">
        <span class="footer-affiliation__label">Parte de la organización</span>
        <span class="footer-affiliation__name">The Dash Studios</span>
      </span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    background: var(--paper);
    color: var(--ink);
    padding: 2.5rem var(--page-gutter);
  }

  .foot-inner {
    max-width: var(--layout-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* Wordmark */
  .foot-brand {
    display: inline-flex;
    opacity: 0.85;
    transition: opacity 0.25s var(--e), transform 0.25s var(--e);
  }
  .foot-brand:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  .foot-fuente {
    width: auto;
    height: 1.4rem;
  }

  /* Sitio */
  .foot-site {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: var(--type-caption);
    letter-spacing: 0.12em;
    color: rgba(22, 20, 15, 0.65);
    transition: color 0.25s var(--e);
  }
  .foot-site:hover { color: var(--ink); }

  /* Instagram */
  .foot-ig {
    display: inline-flex;
    opacity: 0.7;
    transition: opacity 0.25s var(--e), transform 0.25s var(--e);
  }
  .foot-ig:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  .foot-ig img {
    width: auto;
    height: 1.15rem;
  }

  /* Símbolo */
  .foot-mark {
    display: inline-flex;
    opacity: 0.85;
    transition: opacity 0.25s var(--e), transform 0.25s var(--e);
  }
  .foot-mark:hover {
    opacity: 1;
    transform: translateY(-2px) rotate(-6deg);
  }
  .foot-mark img {
    width: auto;
    height: 1.4rem;
  }

  .foot-signature {
    max-width: var(--layout-max);
    margin: 1.25rem auto 0;
  }

  .footer-affiliation {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-affiliation :global(.footer-affiliation__mark) {
    width: 2rem;
    height: 2rem;
    flex: none;
    color: var(--ink);
  }

  .footer-affiliation__copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    line-height: 1.4;
  }

  .footer-affiliation__label {
    color: rgba(22, 20, 15, 0.65);
    font-size: var(--type-caption);
  }

  .footer-affiliation__name {
    color: var(--ink);
    font-size: var(--type-body-sm);
    font-weight: 550;
  }

  .footer-affiliation:hover .footer-affiliation__name,
  .footer-affiliation:focus-visible .footer-affiliation__name {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .footer-affiliation:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
  }

  @media (forced-colors: active) {
    .footer-affiliation :global(.footer-affiliation__mark),
    .footer-affiliation__label,
    .footer-affiliation__name {
      color: LinkText;
    }
  }

  @media (max-width: 640px) {
    .foot-inner {
      gap: 1rem;
    }
    .foot-fuente { height: 1.1rem; }
    .foot-site { font-size: var(--type-label); letter-spacing: 0.08em; }
    .foot-ig img { height: 1rem; }
    .foot-mark img { height: 1.1rem; }
  }
</style>
