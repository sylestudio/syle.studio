---
const year = "2025";
---

<footer class="site-footer">
  <div class="foot-inner">
    <!-- Wordmark -->
    <a href="/" class="foot-brand" aria-label="syle.studio">
      <img class="foot-fuente" src="/img/Syle_Fuente_Negro%20(1).svg" alt="SYLE" />
    </a>

    <!-- Sitio -->
    <a href="https://sylestudio.com" class="foot-site ln">SYLESTUDIO.COM</a>

    <!-- Instagram -->
    <a
      href="https://instagram.com/sylestudio"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
      class="foot-ig"
    >
      <img src="/img/instagram.svg" alt="Instagram" />
    </a>

    <!-- Símbolo -->
    <a href="/" class="foot-mark" aria-label="syle.studio">
      <img src="/img/Syle_Logo_Negro%20(1).svg" alt="Syle" />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    background: var(--paper);
    color: var(--ink);
    padding: 2.5rem 1.5rem;
  }

  .foot-inner {
    max-width: 1820px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* Wordmark */
  .foot-brand {
    display: inline-flex;
    opacity: 0.85;
    transition: opacity 0.25s var(--e), transform 0.25s var(--e);
  }
  .foot-brand:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  .foot-fuente {
    width: auto;
    height: 1.4rem;
  }

  /* Sitio */
  .foot-site {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: rgba(22, 20, 15, 0.65);
    transition: color 0.25s var(--e);
  }
  .foot-site:hover { color: var(--ink); }

  /* Instagram */
  .foot-ig {
    display: inline-flex;
    opacity: 0.7;
    transition: opacity 0.25s var(--e), transform 0.25s var(--e);
  }
  .foot-ig:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  .foot-ig img {
    width: auto;
    height: 1.15rem;
  }

  /* Símbolo */
  .foot-mark {
    display: inline-flex;
    opacity: 0.85;
    transition: opacity 0.25s var(--e), transform 0.25s var(--e);
  }
  .foot-mark:hover {
    opacity: 1;
    transform: translateY(-2px) rotate(-6deg);
  }
  .foot-mark img {
    width: auto;
    height: 1.4rem;
  }

  @media (min-width: 768px) {
    .site-footer {
      padding: 2rem 3rem;
    }
  }

  @media (max-width: 640px) {
    .foot-inner {
      gap: 1rem;
    }
    .foot-fuente { height: 1.1rem; }
    .foot-site { font-size: 0.62rem; letter-spacing: 0.08em; }
    .foot-ig img { height: 1rem; }
    .foot-mark img { height: 1.1rem; }
  }
</style>
